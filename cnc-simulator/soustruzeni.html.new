jezd / odjezd",unit:"mm",def:2,min:0,hint:"odstup nad povrchem a p\u0159esah za \u010Delem"},{k:"FF1",label:"Posuv",unit:"mm/ot",def:.2,min:.001}]},{id:"finish",word:"CYCLE95",label:"Dokon\u010Den\xED kontury",vari:5,note:"Jeden pr\u016Fjezd po cel\xE9m obrysu na\u010Disto, v\u010Detn\u011B \u010Dela. Bez p\u0159\xEDdavku \u2014 jede se na hotov\xFD rozm\u011Br.",fields:[{k:"NPP",label:"Kontura",txt:!0,def:"L7",hint:"n\xE1zev podprogramu s obrysem"},{k:"DIST",label:"N\xE1jezd",unit:"mm",def:2,min:0,hint:"o kolik se naj\xED\u017Ed\xED p\u0159ed obrys, aby se n\u016F\u017E usadil ve vzduchu"},{k:"FF3",label:"Posuv",unit:"mm/ot",def:.12,min:.001,hint:"men\u0161\xED ne\u017E u hrubov\xE1n\xED"}]},{id:"groove",word:"CYCLE93",label:"Z\xE1pich",note:"Zapichuje po kroc\xEDch na hloubku, \u0161irok\xFD z\xE1pich vymete n\u011Bkolika zap\xEDchnut\xEDmi vedle sebe. Tvarov\xE1 pole ve druh\xE9m sloupci m\u016F\u017Eou z\u016Fstat nulov\xE1 \u2014 pak vyjde oby\u010Dejn\xFD pravo\xFAhl\xFD z\xE1pich.",legend:"N\xE1\u010Drt ukazuje skute\u010Dn\xFD tvar podle zadan\xFDch hodnot a m\u011Bn\xED se s nimi; dole je useknut\xFD, ty\u010D pokra\u010Duje k ose v\u0159etena. \u0160\xED\u0159ka se d\xE1 zadat na dn\u011B nebo jako celkov\xE1 u povrchu \u2014 druh\xFD rozm\u011Br se dopo\u010D\xEDt\xE1 a oba jsou vypsan\xE9 pod n\xE1\u010Drtem. Do programu se v\u017Edycky zap\xED\u0161e \u0161\xED\u0159ka na dn\u011B, proto\u017Ee tak cyklus po\u010D\xEDt\xE1. U roh\u016F znamen\xE1 kladn\xE1 hodnota r\xE1dius, z\xE1porn\xE1 zkosen\xED a nula nech\xE1 roh ostr\xFD. Vpravo je strana u po\u010D\xE1te\u010Dn\xEDho bodu, vlevo protilehl\xE1. P\u0159\xEDdavek nech\xE1 hrubov\xE1n\xED dokon\u010Dovac\xEDmu pr\u016Fchodu \u2014 ten teprve ud\u011Bl\xE1 r\xE1diusy, zkosen\xED a \u0161ikm\xE9 boky.",local:[{k:"WREF",label:"\u0160\xED\u0159ka plat\xED pro",after:"WIDG",def:1,opts:[[1,"dno z\xE1pichu"],[2,"celkovou \u0161\xED\u0159ku u povrchu"]],hint:"u povrchu se m\u011B\u0159\xED mezi boky, bez r\xE1dius\u016F a zkosen\xED naho\u0159e"}],derive:e=>{let t={...e};if(Math.round(parseFloat(e.WREF))!==2)return t;let n=i=>parseFloat(e[i]),r=(Math.abs(n("SPD"))-Math.abs(n("DIAG")))/2,o=i=>Math.tan(Math.abs(n(i)||0)*Math.PI/180),l=n("WIDG")-r*(o("ANG1")+o("ANG2"));return Number.isFinite(l)&&(t.WIDG=T(l)),t},fields:[{k:"SPD",label:"Pr\u016Fm\u011Br",unit:"mm",def:40,min:.01,hint:"povrch, odkud se zapichuje"},{k:"SPL",label:"Poloha Z",unit:"mm",def:-20,hint:"prav\xFD horn\xED roh z\xE1pichu"},{k:"WIDG",label:"\u0160\xED\u0159ka na dn\u011B",unit:"mm",def:5,min:.01,hint:"odm\u011B\u0159uje se doleva"},{k:"DIAG",label:"Pr\u016Fm\u011Br dna",unit:"mm",def:30,min:.01,hint:"na jak\xFD pr\u016Fm\u011Br se zapichuje, ne hloubka"},{k:"FF1",label:"Posuv",unit:"mm/ot",def:.08,min:.001},{k:"IDEP",label:"P\u0159\xEDsuv",unit:"mm",def:2,min:.01,hint:"hloubka jednoho kroku, mezi kroky se l\xE1me t\u0159\xEDska"},{k:"FAL",label:"P\u0159\xEDdavek",unit:"mm",def:.2,min:0,hint:"na dn\u011B i na boc\xEDch"},{k:"ANG1",label:"\xDAhel vpravo",unit:"\xB0",def:0,min:0,max:60,col2:!0,hint:"od svislice, bok se rozev\xEDr\xE1 nahoru"},{k:"ANG2",label:"\xDAhel vlevo",unit:"\xB0",def:0,min:0,max:60},{k:"RCO1",label:"Roh vpravo naho\u0159e",unit:"mm",def:0,hint:"kladn\xE9 = r\xE1dius, z\xE1porn\xE9 = zkosen\xED"},{k:"RCO2",label:"Roh vlevo naho\u0159e",unit:"mm",def:0},{k:"RCI1",label:"Roh vpravo na dn\u011B",unit:"mm",def:0},{k:"RCI2",label:"Roh vlevo na dn\u011B",unit:"mm",def:0},{k:"SPT",label:"Programovan\xFD bod no\u017Ee",def:1,min:1,max:3,step:1,opts:[[1,"lev\xFD roh b\u0159itu"],[3,"prav\xFD roh b\u0159itu"]],hint:"zapichovac\xED n\u016F\u017E m\xE1 orientaci 8, tak\u017Ee roh se z korekce nepozn\xE1"}]},{id:"partoff",word:"CYCLE92",label:"Up\xEDchnut\xED",note:"Odd\u011Bl\xED hotov\xFD kus. Zapichuje po kroc\xEDch s odleh\u010Den\xEDm, na hran\u011B sou\u010D\xE1sti um\xED ud\u011Blat zkosen\xED nebo r\xE1dius a p\u0159ed osou zpomalit.",legend:"Poloha Z je hrana na stran\u011B hotov\xE9ho kusu \u2014 ten le\u017E\xED vpravo od \u0159ezu a po up\xEDchnut\xED odpadne. \u0160\xED\u0159ka \u0159ezu nen\xED parametr, je to \u0161\xED\u0159ka b\u0159itu. U hrany znamen\xE1 kladn\xE1 hodnota r\xE1dius, z\xE1porn\xE1 zkosen\xED. Kone\u010Dn\xFD pr\u016Fm\u011Br 0 up\xEDchne \xFApln\u011B, v\u011Bt\u0161\xED hodnota nech\xE1 kus viset na \u010Depu. Bl\xEDzko osy se v konstantn\xED \u0159ezn\xE9 rychlosti ot\xE1\u010Dky \u017Eenou nahoru, proto se od zadan\xE9ho pr\u016Fm\u011Bru p\u0159epne na konstantn\xED ot\xE1\u010Dky a ubere posuv; nechat ob\u011B pole nulov\xE1 znamen\xE1 jet po\u0159\xE1d stejn\u011B.",fields:[{k:"SPD",label:"Pr\u016Fm\u011Br",unit:"mm",def:40,min:.01,hint:"odkud se zapichuje"},{k:"SPL",label:"Poloha Z",unit:"mm",def:-50,hint:"hrana na stran\u011B hotov\xE9ho kusu"},{k:"DIAG2",label:"Kone\u010Dn\xFD pr\u016Fm\u011Br",unit:"mm",def:0,min:0,hint:"0 = up\xEDchnout \xFApln\u011B"},{k:"RC",label:"Hrana",unit:"mm",def:0,hint:"kladn\xE9 = r\xE1dius, z\xE1porn\xE9 = zkosen\xED, nula = ostr\xE1"},{k:"FF1",label:"Posuv",unit:"mm/ot",def:.06,min:.001,col2:!0},{k:"IDEP",label:"P\u0159\xEDsuv",unit:"mm",def:2,min:.01,hint:"hloubka jednoho kroku, mezi kroky se l\xE1me t\u0159\xEDska"},{k:"DIAG1",label:"Zpomalit od \xD8",unit:"mm",def:6,min:0,hint:"0 = nezpomalovat"},{k:"FF2",label:"Zpomalen\xFD posuv",unit:"mm/ot",def:.03,min:0},{k:"SV2",label:"Ot\xE1\u010Dky pod t\xEDm",unit:"1/min",def:800,min:0,step:10,hint:"p\u0159epne na G97, 0 = nep\u0159ep\xEDnat"},{k:"SPT",label:"Programovan\xFD bod no\u017Ee",def:1,min:1,max:3,step:1,opts:[[1,"lev\xFD roh b\u0159itu"],[3,"prav\xFD roh b\u0159itu"]],hint:"zapichovac\xED n\u016F\u017E m\xE1 orientaci 8, tak\u017Ee roh se z korekce nepozn\xE1"}]},{id:"drill",word:"CYCLE83",label:"Vrt\xE1n\xED",note:"Vrt\xE1 v ose v\u0159etena. Po kroc\xEDch s vyjet\xEDm ven, aby se odvedla t\u0159\xEDska; jeden krok rovn\xFD cel\xE9 hloubce znamen\xE1 vrtat najednou.",legend:"Hloubka je sou\u0159adnice Z. P\u0159ep\xEDna\u010D \u0159\xEDk\xE1, \u010Deho se t\xFDk\xE1: hrotu vrt\xE1ku, jak se to programuje na stroji, nebo pln\xE9ho pr\u016Fm\u011Bru d\xEDry. Rozd\xEDl je d\xE9lka ku\u017Eele \u0161pi\u010Dky \u2014 u vrt\xE1ku \xD88 se \u0161pi\u010Dkou 118\xB0 zhruba 2,4 mm. P\u0159i volb\u011B na pln\xFD pr\u016Fm\u011Br cyklus o ten ku\u017Eel dovrt\xE1 s\xE1m, tak\u017Ee se hloubka d\xE1 ode\u010D\xEDst rovnou z v\xFDkresu. Vrt\xE1 se v ose, proto se p\u0159ed cyklus ned\xE1v\xE1 X.",fields:[{k:"RFP",label:"Rovina",unit:"mm",def:0,hint:"Z, odkud se vrt\xE1, obvykle \u010Delo"},{k:"DP",label:"Hloubka",unit:"mm",def:-30,hint:"Z hrotu vrt\xE1ku, z\xE1porn\xE9"},{k:"FDEP",label:"Krok",unit:"mm",def:5,min:.01,col2:!0,hint:"hloubka jednoho zavrt\xE1n\xED"},{k:"FF1",label:"Posuv",unit:"mm/ot",def:.1,min:.001},{k:"SDIS",label:"Odstup",unit:"mm",def:2,min:0,hint:"kam se vyjede mezi kroky"},{k:"TIP",label:"Hloubka plat\xED pro",def:1,min:1,max:2,step:1,opts:[[1,"hrot vrt\xE1ku"],[2,"pln\xFD pr\u016Fm\u011Br d\xEDry"]],hint:"na pln\xFD pr\u016Fm\u011Br se dovrt\xE1 o ku\u017Eel \u0161pi\u010Dky hloub\u011Bji"}]},{id:"thread",word:"CYCLE97",label:"Z\xE1vit",note:"Vn\u011Bj\u0161\xED z\xE1vit v n\u011Bkolika pr\u016Fchodech. P\u0159isouv\xE1 se radi\xE1ln\u011B a hloubka se d\u011Bl\xED rovnom\u011Brn\u011B; posuv je stoup\xE1n\xED, nezad\xE1v\xE1 se zvl\xE1\u0161\u0165.",legend:"Hloubka se dopo\u010D\xEDt\xE1 ze stoup\xE1n\xED jako 0,613 \xD7 P, co\u017E je metrick\xFD profil podle normy; p\u0159epsat ji jde kdykoli a od t\xE9 chv\xEDle si zadanou hodnotu dr\u017E\xED. N\xE1jezd a odjezd prodlu\u017Euj\xED dr\xE1hu v ose Z za konce z\xE1vitu \u2014 v\u0159eteno pot\u0159ebuje kus dr\xE1hy na srovn\xE1n\xED, jinak m\xE1 za\u010D\xE1tek \u0161patn\xE9 stoup\xE1n\xED. Pr\u016Fchody bez t\u0159\xEDsky projedou je\u0161t\u011B jednou po hotov\xE9 hloubce a srovnaj\xED profil. Pozor: profil kresl\xED jen pr\u016Fm\u011Br, ne \u0161roubovici, tak\u017Ee se z\xE1vit uk\xE1\u017Ee jako dr\xE1\u017Eka po cel\xE9 d\xE9lce.",fields:[{k:"PIT",label:"Stoup\xE1n\xED",unit:"mm",def:1.5,min:.01},{k:"DIATH",label:"Pr\u016Fm\u011Br",unit:"mm",def:32,min:.01,hint:"jmenovit\xFD pr\u016Fm\u011Br z\xE1vitu"},{k:"SPL",label:"Za\u010D\xE1tek Z",unit:"mm",def:0},{k:"FPL",label:"Konec Z",unit:"mm",def:-20},{k:"TDEP",label:"Hloubka",unit:"mm",def:.92,min:0,auto:{from:"PIT",calc:e=>.6134*e},hint:"na polom\u011Bru, 0 = dopo\u010D\xEDtat ze stoup\xE1n\xED"},{k:"NSP",label:"Pr\u016Fchod\u016F",def:5,min:1,step:1,col2:!0},{k:"NID",label:"Bez t\u0159\xEDsky",def:1,min:0,step:1,hint:"pr\u016Fchody nav\xEDc po hotov\xE9 hloubce"},{k:"APP",label:"N\xE1jezd",unit:"mm",def:3,min:0,hint:"prodlou\u017Een\xED dr\xE1hy v Z"},{k:"ROP",label:"Odjezd",unit:"mm",def:2,min:0}]}],cf=.5,li=.05,Mr=1,df=.3;function Bs(e){return`G0 Z${T(e)}`}function U0(e){let t=1;for(;t<e.length&&Math.abs(e[t].z-e[0].z)<1e-9;)t++;return t>1?e.slice(t-1):e}function T(e){let t=Math.abs(e)<1e-9?0:e;return String(Math.round(t*1e3)/1e3)}function pf(e,t){if(!(Math.abs(t)>1e-9)||e.length<2)return e.slice();let n=[];for(let o=1;o<e.length;o++){let l=e[o-1],i=e[o],s=i.z-l.z,a=i.r-l.r,c=Math.hypot(s,a);if(c<1e-9)continue;let y=a/c*t,v=-s/c*t;n.push({a:{z:l.z+y,r:l.r+v,si:o-1},b:{z:i.z+y,r:i.r+v,si:o-1},dz:s/c,dr:a/c,vz:i.z,vr:i.r,si:o-1})}if(!n.length)return e.slice();let r=[n[0].a];for(let o=0;o<n.length;o++){let l=n[o],i=n[o+1];if(!i){r.push(l.b);break}if((l.dz*i.dr-l.dr*i.dz)*t>1e-12){r.push(l.b);let a=Math.atan2(l.b.r-l.vr,l.b.z-l.vz),y=Math.atan2(i.a.r-l.vr,i.a.z-l.vz)-a;for(;y>Math.PI;)y-=2*Math.PI;for(;y<-Math.PI;)y+=2*Math.PI;let v=Math.max(2,Math.ceil(Math.abs(y)/(5*Math.PI/180)));for(let h=1;h<v;h++){let w=a+y*h/v;r.push({z:l.vz+Math.cos(w)*Math.abs(t),r:l.vr+Math.sin(w)*Math.abs(t),si:l.si})}r.push(i.a)}else{let a=l.dz*i.dr-l.dr*i.dz;if(Math.abs(a)<1e-9){r.push(l.b);continue}let c=((i.a.z-l.a.z)*i.dr-(i.a.r-l.a.r)*i.dz)/a;r.push({z:l.a.z+l.dz*c,r:l.a.r+l.dr*c,si:l.si})}}return r}function Hs(e,t,n,r,o,l,i,s){let a=t.map(v=