 .man h2{font-size:15px;margin:22px 0 8px;padding-bottom:6px;border-bottom:1px solid ${P.line};
   color:${P.feed};font-weight:650;scroll-margin-top:8px}
 .man h3{font-size:13px;margin:16px 0 6px;color:${P.note};font-weight:650;scroll-margin-top:8px}
 .man p{margin:0 0 9px}
 .man ul{margin:0 0 9px;padding-left:20px}
 .man li{margin:0 0 5px}
 .man table{border-collapse:collapse;width:100%;margin:0 0 10px;table-layout:fixed}
 .man th,.man td{text-align:left;vertical-align:top;padding:5px 10px 5px 0;
   border-bottom:1px solid ${P.line};font-weight:400;overflow-wrap:break-word}
 .man th{color:${P.note};font-weight:650}
 .man td.mono{font-family:ui-monospace,Menlo,monospace;color:${P.note}}
 .man pre{margin:0 0 10px;padding:9px 11px;background:${P.panel2};border:1px solid ${P.line};
   border-radius:6px;font-family:ui-monospace,Menlo,monospace;line-height:1.65;
   color:${P.gcode};overflow:auto;white-space:pre}
 .man .pozn{margin:0 0 10px;padding:8px 11px;border-left:3px solid ${P.tool};
   background:${P.panel2};border-radius:0 6px 6px 0}
 .man .pozn b{color:${P.tool}}
 .man .osnova{margin:0 0 18px;padding:10px 12px;background:${P.panel2};
   border:1px solid ${P.line};border-radius:6px}
 .man .osnova b{display:block;margin-bottom:6px;color:${P.note}}
 .man .osnova ul{margin:0;padding:0;list-style:none;columns:2;column-gap:22px}
 .man .osnova li{margin:0 0 3px;break-inside:avoid}
 .man .osnova .u2{padding-left:14px}
 .man .osnova a{color:${P.gcode};text-decoration:none}
 .man .osnova a:hover{text-decoration:underline}
`,P0=`
.cnc-root{
  --bg:${P.bg}; --panel:${P.panel}; --panel2:${P.panel2}; --line:${P.line}; --edge:${P.edge};
  --txt:${P.txt}; --dim:${P.dim}; --steel:${P.steel}; --cut:${P.cut};
  --feed:${P.feed}; --rapid:${P.rapid}; --tool:${P.tool}; --prog:${P.prog};
  --field:${P.field}; --btn:${P.btn}; --btn-hover:${P.btnHover}; --faint:${P.faint};
  --note:${P.note}; --cmt:${P.cmt}; --on-feed:${P.onFeed}; --err:${P.err};
  --err-gutter:${P.errGutter}; --white:${P.white}; --warn:${P.warn}; --glass:${P.glass}; --hair:${P.hair};
  position:absolute; inset:0; display:flex; flex-direction:column;
  background:var(--bg); color:var(--txt); overflow:hidden;
  font-family:ui-sans-serif,-apple-system,"Segoe UI",Roboto,sans-serif; font-size:13px;
}
.cnc-root *{box-sizing:border-box}
.mono{font-family:ui-monospace,"SF Mono",Menlo,Consolas,"DejaVu Sans Mono",monospace}
.bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  padding:8px 12px;border-bottom:1px solid var(--line);background:var(--panel)}
.brand{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);
  font-weight:600;white-space:nowrap}
.bar .fname{margin-right:auto;font-size:12px;color:var(--dim);white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;max-width:26%}
.bar .fname b{color:var(--txt);font-weight:600}
.bar .fname .star{color:var(--tool);font-weight:700}
.brand b{color:var(--txt);letter-spacing:.1em}
.bar .grp{display:flex;align-items:center;gap:8px}
.bar .grp.view{margin-left:10px;padding-left:12px;border-left:1px solid var(--line)}
.btn,.fbtn{transition:background .08s,border-color .08s,color .08s}
.btn{background:var(--btn);border:1px solid var(--edge);color:var(--txt);
  padding:6px 11px;border-radius:5px;font-size:12.5px;cursor:pointer;letter-spacing:.03em}
.btn:hover,.fbtn:hover{background:var(--btn-hover);border-color:var(--dim)}
.btn:active,.fbtn:active{transform:translateY(1px)}
.btn:disabled,.fbtn:disabled{opacity:.45;cursor:default}
.btn:focus-visible{outline:2px solid var(--feed);outline-offset:2px}
.btn.on{background:var(--feed);border-color:var(--feed);color:var(--on-feed);font-weight:600}
.btn.on:hover{background:var(--feed);filter:brightness(1.08)}
.btn.ghost{background:transparent}
/* .btn.ghost je a\u017E za .btn.on a p\u0159i stejn\xE9 specifi\u010Dnosti mu p\u0159ebije pozad\xED na
   pr\u016Fhledn\xE9 \u2014 bez tohohle pravidla by zbyl tmav\xFD text z .btn.on na tmav\xE9m podkladu */
.btn.ghost.on{background:${P.feedSel};border-color:var(--feed);color:var(--feed);font-weight:600}
.btn.ghost.on:hover{background:${P.feedSel};filter:brightness(1.15)}
.sel{background:var(--btn);border:1px solid var(--edge);color:var(--txt);
  padding:6px 8px;border-radius:5px;font-size:12.5px}
.main{flex:1;display:flex;min-height:0}
.split{flex:none;width:6px;cursor:col-resize;background:var(--panel2);
  border-right:1px solid var(--line)}
.split:hover,.split.on{background:var(--feed)}
.left{width:393px;min-width:340px;flex:none;display:flex;flex-direction:column;
  background:var(--panel);min-height:0;overflow:hidden}
.right{flex:1;position:relative;min-width:0;background:var(--bg)}
.hd{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);
  padding:9px 12px 6px;font-weight:600}
.edwrap{flex:1;display:flex;min-height:140px;position:relative;border-top:1px solid var(--line)}
.gutter{width:calc(var(--ed-fs) * 3.2 + 14px);background:var(--panel2);border-right:1px solid var(--line);
  overflow:hidden;padding:10px 0;text-align:right;flex:none}
/* POZOR na selektor: \u201E.gutter div\u201C chyt\xED i obalov\xFD prvek s posunem,
   ne jenom \u0159\xE1dky. Kdy\u017E se mu d\xE1 display:flex, poskl\xE1daj\xED se v\u0161echna
   \u010D\xEDsla vedle sebe do \xFAzk\xE9ho \u017El\xE1bku a v\u0161echno krom\u011B prvn\xEDho zmiz\xED za
   okrajem \u2014 v\u010Detn\u011B tla\u010D\xEDtka na \xFApravu cyklu. Proto t\u0159\xEDda .gln. */
.gutter .gln{display:flex;align-items:center;justify-content:flex-end;gap:4px;
  font-size:var(--ed-fs);line-height:var(--ed-lh);height:var(--ed-lh);
  padding-right:8px;color:var(--faint)}
.gutter .gln.act{color:var(--on-feed);background:var(--feed);font-weight:700}
.gutter .gln.err{color:var(--err-gutter)}
.edscroll{flex:1;position:relative;min-width:0;overflow:hidden}
.hl{position:absolute;left:0;right:0;height:var(--ed-lh);background:${P.feedGhost};z-index:0;
  border-left:2px solid var(--feed);pointer-events:none}
.ta{position:absolute;inset:0;width:100%;height:100%;resize:none;border:0;z-index:2;
  background:transparent;color:transparent;padding:10px 12px;
  font-size:var(--ed-fs);line-height:var(--ed-lh);letter-spacing:.02em;
  white-space:pre;overflow:auto;outline:none;caret-color:var(--feed)}
.ta::selection{background:${P.feedSel}}
.hlite{position:absolute;inset:0;margin:0;padding:10px 12px;z-index:1;
  font-size:var(--ed-fs);line-height:var(--ed-lh);letter-spacing:.02em;white-space:pre;
  overflow:hidden;pointer-events:none;color:var(--txt)}
.hlite .ln{display:block;height:var(--ed-lh)}
.c-cmt{color:var(--cmt);font-style:italic}
.c-n{color:var(--faint)}
.c-rapid{color:var(--rapid)}
.c-feed{color:var(--feed)}
.c-g{color:${P.gcode}}
.c-m{color:var(--tool)}
.c-f{color:${P.fword}}
.c-ang{color:#ffffff}
.c-cyc{color:${P.contour};font-weight:700}
/* rozbalovac\xED nab\xEDdka cykl\u016F */
.dd{position:relative}
.ddmenu{position:absolute;left:0;top:calc(100% + 5px);z-index:40;min-width:190px;
  background:var(--panel2);border:1px solid var(--edge);border-radius:6px;padding:4px;
  box-shadow:0 10px 26px rgba(0,0,0,.55)}
.ddmenu button{display:block;width:100%;text-align:left;background:none;border:0;
  color:var(--txt);font-size:12.5px;padding:7px 9px;border-radius:4px;cursor:pointer}
.ddmenu button:hover{background:var(--field);color:var(--feed)}
/* okno cyklu */
.modal{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.55);
  display:flex;align-items:center;justify-content:center;padding:20px}
/* P\u0159\xEDru\u010Dka: dlouh\xFD text, proto vlastn\xED t\u011Blo s vlastn\xEDm rolov\xE1n\xEDm.
   Vlastn\xED vzhled kapitol je v MANUAL_CSS \u2014 sd\xEDl\xED ho okno i samostatn\xE1
   str\xE1nka, aby vypadaly stejn\u011B. */
.helpbody{padding:14px 18px 4px;max-height:min(68vh,660px);overflow:auto;
  font-size:12.5px;line-height:1.6;color:var(--txt)}
.helpbody>*:first-child{margin-top:0}
${lf}
.mbox{background:var(--panel);border:1px solid var(--edge);border-radius:10px;
  width:min(680px,100%);max-height:100%;overflow:auto;box-shadow:0 20px 60px rgba(0,0,0,.6)}
/* okno cyklu, kter\xFD m\xE1 parametry ve dvou sloupc\xEDch */
.mbox.wide{width:min(1020px,100%)}
.mbox.wide .mpic{flex:1 1 320px;min-width:300px}
.mhd{padding:14px 18px 10px;border-bottom:1px solid var(--line)}
.mhd h3{margin:0;font-size:14.5px;font-weight:650;color:var(--txt)}
.mhd p{margin:5px 0 0;font-size:11.5px;color:var(--dim);line-height:1.5}
.mbody{display:flex;gap:16px;padding:16px 18px;flex-wrap:wrap}
.mpic{flex:1 1 250px;min-width:230px;background:var(--field);border:1px solid var(--edge);
  border-radius:6px;padding:8px}
/* popis parametr\u016F pod n\xE1kresem \u2014 norm\xE1ln\xED text, zalamuje se s\xE1m */
.mleg{margin:8px 2px 2px;font-size:10.5px;line-height:1.55;color:var(--note);
  white-space:normal;overflow-wrap:break-word;text-wrap:pretty}
/* rozm\u011Bry \u017Eiv\xE9ho n\xE1\u010Drtu: pat\u0159\xED k obr\xE1zku, proto sed\xED hned pod n\xEDm
   a odd\u011Bluje se linkou od obecn\xE9ho popisu parametr\u016F */
.mkoty{margin:6px 2px 0;padding-bottom:7px;border-bottom:1px solid var(--line);
  font-size:11px;line-height:1.55;color:var(--txt);
  white-space:normal;overflow-wrap:break-word;text-wrap:pretty}
.mkoty.zle{color:var(--err);border-bottom-color:transparent}
.mfields{flex:1 1 240px;min-width:230px;display:grid;grid-template-columns:auto 1fr;
  gap:8px 10px;align-items:center;align-content:start}
.mfields .ax{font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--dim)}
.mfields .hint{grid-column:1 / -1;font-size:10.5px;color:var(--faint);margin:-4px 0 4px}
.mft{display:flex;justify-content:flex-end;align-items:center;gap:8px;padding:12px 18px 16px;
  border-top:1px solid var(--line)}
/* hl\xE1\u0161ka u OK: dr\u017E\xED se vlevo, tla\u010D\xEDtka z\u016Fst\xE1vaj\xED vpravo */
.mft .cerr{margin-right:auto;font-size:11.5px;line-height:1.35;color:var(--err)}
/* tu\u017Eka u \u010D\xEDsla \u0159\xE1dku */
.gcyc{flex:none;cursor:pointer;color:${P.contour};font-size:11px;line-height:1;
  padding:0 1px;border:0;background:none}
.gcyc:hover{color:var(--feed)}
.filerow{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:6px 12px 8px}
.filerow .grp{display:flex;align-items:center;gap:6px}
.filerow .grp.right{flex-basis:100%;margin-top:2px}
.filerow .grp .lbl{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint)}
.filerow .name{margin-left:auto;font-size:11.5px;color:var(--dim);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:46%}
.filerow .name b{color:var(--txt);font-weight:600}
.filerow .dot{color:var(--tool)}
.fbtn{background:var(--btn);border:1px solid var(--edge);color:var(--txt);
  padding:4px 9px;border-radius:5px;font-size:11.5px;cursor:pointer;white-space:nowrap}
.fbtn:hover{background:var(--btn-hover)}
.fbtn:focus-visible{outline:2px solid var(--feed);outline-offset:2px}
.fbtn.on{background:var(--feed);border-color:var(--feed);color:var(--on-feed);font-weight:600}
.fbtn.on:hover{background:var(--feed);filter:brightness(1.08)}
.ovl{position:absolute;inset:0;background:${P.veil};display:flex;
  align-items:center;justify-content:center;z-index:20;padding:20px}
.dlg{background:var(--panel);border:1px solid var(--edge);border-radius:6px;
  padding:0 0 14px;width:min(420px,100%);box-shadow:0 18px 50px ${P.shadow};overflow:hidden}
.dlg h3{margin:0 0 10px;padding:9px 14px 8px;background:var(--panel2);
  border-bottom:1px solid var(--line);font-size:10.5px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--dim);font-weight:600}
.dlg p{margin:0 14px 10px;font-size:12.5px;line-height:1.5;color:var(--txt)}
.dlg .inp{width:calc(100% - 28px);margin:0 14px}
.dlg.wide{width:min(560px,92vw)}
/* okno O programu \u2014 stejn\xE9 jako u fr\xE9zov\xE1n\xED, a\u0165 se oboj\xED chov\xE1 shodn\u011B */
.dlg .about{margin:0 14px 4px;font-size:12.5px;line-height:1.6;color:var(--txt)}
.dlg .about h4{margin:0 0 2px;font-size:15px;color:var(--feed)}
.dlg .about .ver{color:var(--dim);font-size:11.5px;letter-spacing:.04em}
.dlg .about .lic{margin-top:9px;padding-top:9px;border-top:1px solid var(--line);
  color:var(--dim);font-size:11.5px}
.dlg .about a{color:var(--feed)}
.dlg .row{display:flex;gap:8px;justify-content:flex-end;margin:14px 14px 0;
  padding-top:12px;border-top:1px solid var(--line)}
.tabs{display:flex;border-top:1px solid var(--line);background:var(--panel2)}
.tabs button{flex:1;background:none;border:0;border-bottom:2px solid transparent;
  color:var(--dim);padding:9px 2px;font-size:10.5px;letter-spacing:.1em;
  text-transform:uppercase;font-weight:600;cursor:pointer}
.tabs button:hover{color:var(--txt);background:${P.feedGhost}}
.tabs button.on{color:var(--txt);border-bottom-color:var(--feed);background:${P.feedGhost}}
/* stavov\xE1 te\u010Dka u z\xE1lo\u017Eky Kontrola \u2014 sv\xEDt\xED jako kontrolka na p\u0159\xEDstrojov\xE9 desce */
.tabs [class^="dot-"]{display:inline-block;width:7px;height:7px;border-radius:50%;
  margin-left:6px;vertical-align:middle;position:relative;top:-1px}
.dot-err{background:${P.dotErr};box-shadow:0 0 6px ${P.dotErr},0 0 2px ${P.dotErr}}
.dot-warn{background:${P.dotWarn};box-shadow:0 0 6px ${P.dotWarn},0 0 2px ${P.dotWarn}}
.dot-ok{background:${P.dotOk};box-shadow:0 0 6px ${P.dotOk},0 0 2px ${P.dotOk}}
@media (prefers-reduced-motion:no-preference){
  .dot-err{animation:dotPulse 1.6s ease-in-out infinite}
}
@keyframes dotPulse{50%{opacity:.45}}
.tabs .info{display:inline-block;margin-left:6px;width:14px;height:14px;line-height:13px;
  border-radius:50%;border:1px solid var(--tool);color:var(--tool);background:transparent;
  font-size:10px;font-weight:700;font-style:italic;text-align:center;cursor:pointer;
  vertical-align:middle;position:relative;top:-1px;padding:0}
.tabs .info:hover{background:var(--tool);color:${P.onBadge}}
.tabs .info.on{background:var(--tool);color:${P.onBadge}}
.tabs .badge{display:inline-block;margin-left:5px;background:var(--rapid);color:${P.onBadge};
  border-radius:8px;padding:0 5px;font-size:10px}
.pane{height:224px;overflow:auto;padding:10px 12px 14px}
.grid3{display:grid;grid-template-columns:auto 1fr 1fr;gap:7px 9px;align-items:center}
.grid3 .ax{font-size:11px;letter-spacing:.1em;color:var(--dim);text-transform:uppercase}
.inp{background:var(--field);border:1px solid var(--edge);color:var(--txt);
  border-radius:4px;padding:5px 6px;font-size:12.5px;width:100%;
  font-family:ui-monospace,Menlo,Consolas,monospace}
.inp:focus{outline:1px solid var(--feed);border-color:var(--feed)}
.note{font-size:11px;color:var(--dim);line-height:1.5;margin-top:10px}
.note b{color:var(--note)}
.trow{display:grid;grid-template-columns:44px 1fr 66px 50px;gap:7px;align-items:center;
  padding:5px 0;border-bottom:1px solid var(--hair)}
/* Hlavi\u010Dka sloupc\u016F a vzorek barvy nem\u011Bly styl v\u016Fbec \u2014 vzorek byl proto
   neviditeln\xFD (span bez rozm\u011Bru) a hlavi\u010Dka spl\xFDvala s \u0159\xE1dky. */
.chead{gap:7px;align-items:center;font-size:10.5px;letter-spacing:.09em;
  text-transform:uppercase;color:var(--dim);padding-bottom:5px}
.swatch{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:5px;
  vertical-align:middle}
.trow2{display:grid;grid-template-columns:40px 1fr 58px 58px 52px;gap:6px;
  align-items:center;padding:5px 0;border-bottom:1px solid var(--hair)}
.trow2.act{background:rgba(255,255,255,.03)}
.trow2 .t{font-size:11.5px;white-space:nowrap}
.inp:disabled{opacity:.35;cursor:not-allowed}
/* volba sm\u011Bru \u0161pi\u010Dky: tla\u010D\xEDtko se \u0161ipkou a rozev\xEDrac\xED m\u0159\xED\u017Eka 3\xD73
   podle sch\xE9matu ISO */
.dirwrap{position:relative}
.dirbtn{display:flex;align-items:center;justify-content:center;gap:3px;width:100%;
  cursor:pointer;background:var(--field);border:1px solid var(--edge);color:var(--txt);
  border-radius:4px;padding:4px 2px;font-size:12.5px;
  font-family:ui-monospace,Menlo,Consolas,monospace}
.dirbtn:hover{border-color:var(--feed)}
.dirbtn:disabled{opacity:.35;cursor:not-allowed;border-color:var(--edge)}
.dirpop{position:absolute;right:0;top:calc(100% + 4px);z-index:30;
  display:grid;grid-template-columns:repeat(3,32px);gap:3px;padding:6px;
  background:var(--panel2);border:1px solid var(--edge);border-radius:6px;
  box-shadow:0 10px 26px rgba(0,0,0,.55)}
.dircell{display:flex;flex-direction:column;align-items:center;justify-content:center;
  height:32px;gap:1px;background:var(--field);border:1px solid var(--edge);
  border-radius:4px;color:var(--txt);cursor:pointer;line-height:1;padding:0}
.dircell:hover{border-color:var(--feed)}
.dircell.on{border-color:var(--feed);color:var(--feed)}
.dircell .ar{font-size:13px}
.dircell .nm{font-size:8.5px;color:var(--dim)}
.msg{font-size:11.5px;line-height:1.45;padding:3px 0;color:var(--err);display:flex;gap:7px}
.msg .n{color:var(--dim);flex:none}
.msg.warn{color:var(--warn)}
.msg.ok{color:var(--dim)}
.chk{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--txt);padding:3px 0}
.chk input{accent-color:var(--feed)}
canvas{display:block;width:100%;height:100%;cursor:crosshair}
.dro{position:absolute;left:50%;transform:translateX(-50%);bottom:14px;background:var(--glass);
  border:1px solid var(--line);border-radius:6px;padding:9px 4px;
  display:flex;align-items:stretch;pointer-events:none;backdrop-filter:blur(3px);
  max-width:calc(100% - 28px);flex-wrap:wrap;justify-content:center}
.dro .g{display:flex;gap:14px;padding:0 14px;border-left:1px solid var(--line);flex-wrap:wrap}
.dro{row-gap:8px}
.dro .g:first-child{border-left:0}
.dro .k{font-size:9.5px;letter-spacing:.14em;color:var(--dim);text-transform:uppercase;white-space:nowrap}
.dro .v{font-size:16px;font-weight:600;letter-spacing:.02em;white-space:nowrap}
.dro .g.pos .v{font-size:20px}
.dro .g.cond .v{font-size:14px}
.dro .v.warnv{color:var(--tool)}
.stats{position:absolute;right:14px;top:14px;background:var(--glass);
  border:1px solid var(--line);border-radius:6px;padding:9px 12px;
  color:var(--dim);pointer-events:none;backdrop-filter:blur(3px);
  display:grid;grid-template-columns:auto auto;gap:5px 14px;align-items:baseline}
.stats .k{font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}
.stats .v{font-size:14px;font-weight:600;color:var(--txt);white-space:nowrap;text-align:right}
.stats .hint{grid-column:1 / -1;font-size:11.5px}
.legend{position:absolute;left:14px;top:14px;display:flex;gap:10px 14px;align-items:center;
  font-size:11px;color:var(--dim);pointer-events:none;max-width:calc(100% - 210px);
  flex-wrap:wrap}
.legend span{white-space:nowrap}
.legend .min{pointer-events:auto;flex:none;order:-1;width:18px;height:18px;line-height:16px;
  border-radius:50%;border:1px solid var(--edge);background:var(--panel);color:var(--dim);
  font-size:12px;text-align:center;cursor:pointer;padding:0}
.legend .min:hover{background:var(--btn-hover);color:var(--txt);border-color:var(--dim)}
.legpill{position:absolute;left:14px;top:14px;background:var(--glass);
  border:1px solid var(--line);border-radius:6px;padding:4px 10px;color:var(--dim);
  font-size:11px;cursor:pointer}
.legpill:hover{color:var(--txt);border-color:var(--dim)}
.legend i{display:inline-block;width:16px;height:0;border-top:2px solid;
  margin-right:6px;vertical-align:middle}
.slider{width:118px;accent-color:var(--feed)}
.cnc-root.proj .dro{padding:12px 6px}
.dro .min{position:absolute;top:-9px;right:-9px;width:20px;height:20px;line-height:18px;
  border-radius:50%;border:1px solid var(--edge);background:var(--panel);color:var(--dim);
  font-size:13px;text-align:center;cursor:pointer;pointer-events:auto;padding:0}
.dro .min:hover{background:var(--btn-hover);color:var(--txt);border-color:var(--dim)}
.dropill{position:absolute;left:50%;transform:translateX(-50%);bottom:14px;
  background:var(--glass);border:1px solid var(--line);border-radius:6px;
  padding:7px 13px;color:var(--dim);font-size:14px;cursor:pointer;backdrop-filter:blur(3px)}
.dropill:hover{color:var(--txt);border-color:var(--dim)}
.cnc-root.proj .dro .g{gap:18px;padding:0 18px}
.cnc-root.proj .dro .k{font-size:11.5px}
.cnc-root.proj .dro .v{font-size:21px}
.cnc-root.proj .dro .g.pos .v{font-size:28px}
.cnc-root.proj .dro .g.cond .v{font-size:18px}
.cnc-root.proj .legend{font-size:14px;gap:18px}
.cnc-root.proj .legend i{width:22px;border-top-width:3px}
.cnc-root.proj .stats .k{font-size:11.5px}
.cnc-root.proj .stats .v{font-size:18px}
.cnc-root.proj .stats .hint{font-size:14px}
.cnc-root.proj .legend{display:none}
.cnc-root.proj .tabs button{font-size:12.5px}
@media (max-width:880px){
  .main{flex-direction:column}
  .split{display:none}
  .left{width:auto!important;height:52%;border-bottom:1px solid var(--line)}
  .pane{height:150px}
  .stats{display:none}
}
