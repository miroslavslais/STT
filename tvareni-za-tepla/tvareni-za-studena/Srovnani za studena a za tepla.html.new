<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Za studena × za tepla | STT</title>
<meta name="description" content="Dosahovaná přesnost IT a drsnost Ra jednotlivých technologií tváření, přídavek na obrábění, kdy zvolit co a tváření za poloohřevu.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23fbf8f3'/%3E%3Ctext x='12' y='17' font-family='Georgia,serif' font-size='12' font-weight='700' fill='%23b0561f' text-anchor='middle'%3ES%3C/text%3E%3C/svg%3E">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <script defer="" src="https://cloud.umami.is/script.js" data-website-id="4c272434-8fc9-49a9-9a2c-b3e710506cae"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&amp;family=IBM+Plex+Sans:wght@400;500;600&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" rel="stylesheet">
  <style>html, body { margin: 0; background: #080b12; } a { color: inherit; text-decoration: none; } a:hover { color: #a9c8e6; }</style>
  <script>
    document.addEventListener('mouseover', function(e){ var el = e.target.closest('.site-nav-toggle'); if (el) el.style.maxHeight = el.scrollHeight + 'px'; });
    document.addEventListener('mouseout', function(e){ var el = e.target.closest('.site-nav-toggle'); if (el && !el.contains(e.relatedTarget)) el.style.maxHeight = '48px'; });
  </script>
</helmet>
<div class="site-nav-toggle" style="position:fixed;top:24px;right:24px;z-index:1000;width:220px;background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;box-shadow:0 2px 10px rgba(35,29,22,0.08);overflow:hidden;max-height:48px;transition:max-height 0.22s ease">
  <div style="height:48px;display:flex;align-items:center;justify-content:center;gap:5px;flex-direction:column;cursor:pointer">
    <span style="width:20px;height:2px;background:#8296a8;border-radius:1px"></span>
    <span style="width:20px;height:2px;background:#8296a8;border-radius:1px"></span>
    <span style="width:20px;height:2px;background:#8296a8;border-radius:1px"></span>
  </div>
  <div style="display:flex;flex-direction:column;border-top:1px solid rgba(150,180,210,0.16)">
    <sc-for list="{{ navItems }}" as="n" hint-placeholder-count="6">
      <a href="{{ n.href }}" style="padding:12px 18px;font-family:'Quicksand',sans-serif;font-weight:600;font-size:14px;color:#eaf2fa" style-hover="background:rgba(150,180,210,0.08)">{{ n.title }}</a>
    </sc-for>
  </div>
</div>
<a href="index.html" style="position:fixed;top:16px;left:16px;z-index:1000;display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,0.08);backdrop-filter:blur(6px);color:#e8ecf3;font-family:'IBM Plex Sans',sans-serif;font-size:14px;font-weight:500;border:1px solid rgba(255,255,255,0.14)">← Zpět na Tváření za studena</a>

<div style="min-height:100vh;background:#080b12;font-family:'IBM Plex Sans',sans-serif;padding:78px 48px 80px;box-sizing:border-box;color:#eaf2fa">
  <div style="max-width:980px;margin:0 auto">
    <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:13.5px;letter-spacing:0.06em;text-transform:uppercase;color:#7ba3cc;margin-bottom:8px">Tváření za studena</div>
    <h1 style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:34px;line-height:1.2;color:#eaf2fa;margin:0 0 20px">Za studena × za tepla</h1>

    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 30px;text-wrap:pretty">Hranicí mezi oběma způsoby je <a href="../teplota-rekrystalizace/Rekrystalizacni teplota.html" style="color: rgb(123, 163, 204); border-bottom: 1px solid rgba(123, 163, 204, 0.4);">teplota rekrystalizace</a>. Z ní plyne všechno ostatní: ohřátý kov klade menší odpor, ale roztahuje se. V zápustce vznikají okuje a nedá se dodržet přesný rozměr. Studený kov je pevný a nástroj i stroj musí být mnohem silnější, zato díl je přesnější a s kvalitnějším povrchem. Přesnost však není hlavním faktorem — mění se s konkrétní technologií.</p>

    <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:22px;color:#eaf2fa;margin:0 0 8px">Dosahovaná přesnost</div>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 18px">Rozsah IT stupňů, které jednotlivé technologie běžně dodrží. Klikni na řádek — dole se ukáže drsnost povrchu, přídavek na obrábění a typické díly. Poslední dva řádky jsou obrábění pro srovnání.</p>

    <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;padding:24px 26px 26px;margin:0 0 30px">
      <div style="display:grid;grid-template-columns:230px 1fr;gap:14px;align-items:end;margin-bottom:10px">
        <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:12px;letter-spacing:0.05em;text-transform:uppercase;color:#8296a8">Technologie</div>
        <div style="display:grid;grid-template-columns:repeat(12,1fr)">
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">5</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">6</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">7</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">8</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">9</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">10</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">11</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">12</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">13</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">14</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">15</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8;text-align:center">16</div>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:5px">
        <sc-for list="{{ rows }}" as="r" hint-placeholder-count="11">
          <div onClick="{{ r.select }}" style="display:grid;grid-template-columns:230px 1fr;gap:14px;align-items:center;cursor:pointer;padding:3px 0">
            <div style="display:flex;align-items:center;gap:8px;min-width:0">
              <span style="width:6px;height:6px;border-radius:50%;flex:none;background:{{ r.dot }}"></span>
              <span style="font-size:13.5px;line-height:1.3;color:{{ r.labelColor }};font-weight:{{ r.labelWeight }}">{{ r.name }}</span>
            </div>
            <div style="position:relative;height:26px;background:rgba(150,180,210,0.05);border-radius:7px">
              <div style="position:absolute;top:0;bottom:0;left:{{ r.left }};width:{{ r.width }};background:{{ r.bg }};border:1px solid {{ r.border }};border-radius:7px;display:flex;align-items:center;justify-content:center"><span style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:{{ r.rangeColor }}">{{ r.range }}</span></div>
            </div>
          </div>
        </sc-for>
      </div>

      <div style="display:flex;gap:18px;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px solid rgba(150,180,210,0.12)">
        <div style="display:flex;align-items:center;gap:7px"><span style="width:12px;height:12px;border-radius:3px;background:rgba(224,140,110,0.5)"></span><span style="font-size:12.5px;color:#8296a8">za tepla</span></div>
        <div style="display:flex;align-items:center;gap:7px"><span style="width:12px;height:12px;border-radius:3px;background:rgba(196,186,96,0.52)"></span><span style="font-size:12.5px;color:#8296a8">za poloohřevu</span></div>
        <div style="display:flex;align-items:center;gap:7px"><span style="width:12px;height:12px;border-radius:3px;background:rgba(123,163,204,0.55)"></span><span style="font-size:12.5px;color:#8296a8">za studena</span></div>
        <div style="display:flex;align-items:center;gap:7px"><span style="width:12px;height:12px;border-radius:3px;background:rgba(150,180,210,0.22)"></span><span style="font-size:12.5px;color:#8296a8">obrábění (srovnání)</span></div>
      </div>

      <div style="margin-top:22px;padding-top:22px;border-top:1px solid rgba(150,180,210,0.16)">
        <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:18px;color:#eaf2fa;margin-bottom:4px">{{ sel.name }}</div>
        <div style="font-size:14.5px;line-height:1.6;color:#aebfcf;margin-bottom:18px;text-wrap:pretty">{{ sel.note }}</div>

        <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:12px;letter-spacing:0.05em;color:#8296a8;margin-bottom:8px">DRSNOST POVRCHU Ra [µm]</div>
        <div style="position:relative;height:24px;background:rgba(150,180,210,0.05);border-radius:6px;margin-bottom:6px">
          <div style="position:absolute;top:0;bottom:0;left:{{ sel.raLeft }};width:{{ sel.raWidth }};background:{{ sel.bg }};border:1px solid {{ sel.border }};border-radius:6px"></div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-bottom:20px">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8">0,1</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8">1</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8">10</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8296a8">100</span>
        </div>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px">
          <div style="background:rgba(150,180,210,0.05);border:1px solid rgba(150,180,210,0.12);border-radius:12px;padding:14px 16px">
            <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:11.5px;letter-spacing:0.05em;color:#8296a8;margin-bottom:6px">Ra</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:15px;color:#eaf2fa">{{ sel.ra }}</div>
          </div>
          <div style="background:rgba(150,180,210,0.05);border:1px solid rgba(150,180,210,0.12);border-radius:12px;padding:14px 16px">
            <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:11.5px;letter-spacing:0.05em;text-transform:uppercase;color:#8296a8;margin-bottom:6px">Přídavek na obrábění</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:15px;color:#eaf2fa">{{ sel.pridavek }}</div>
          </div>
          <div style="background:rgba(150,180,210,0.05);border:1px solid rgba(150,180,210,0.12);border-radius:12px;padding:14px 16px">
            <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:11.5px;letter-spacing:0.05em;text-transform:uppercase;color:#8296a8;margin-bottom:6px">Typické díly</div>
            <div style="font-size:14px;line-height:1.5;color:#eaf2fa">{{ sel.dily }}</div>
          </div>
        </div>
      </div>
    </div>

    <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:22px;color:#eaf2fa;margin:0 0 8px">Co znamená přesnost na hotovém dílu</div>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 18px;text-wrap:pretty">Osový řez stejným čepem s přírubou. Vlevo výkovek ze zápustky, vpravo protlaček za studena. Šrafovaná plocha je materiál, který musí odejít na soustruhu — u výkovku k němu patří i úkosy pro vyjmutí ze zápustky, velká zaoblení přechodů a výronek v dělicí rovině.</p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:0 0 14px">
      <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(224,140,110,0.28);border-radius:16px;padding:20px 22px 18px">
        <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:13px;letter-spacing:0.05em;text-transform:uppercase;color:oklch(0.72 0.16 30);margin-bottom:14px">Zápustkový výkovek — za tepla</div>
        <svg viewBox="0 0 380 210" style="width:100%;display:block">
          <defs>
            <pattern id="allow" width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
              <line x1="0" y1="0" x2="0" y2="7" stroke="oklch(0.72 0.16 30)" stroke-width="1.6" opacity="0.55"></line>
            </pattern>
          </defs>
          <polygon points="122,160 116,134 120,104 154,104 160,36 220,36 226,104 260,104 264,134 258,160" fill="url(#allow)" stroke="oklch(0.72 0.16 30)" stroke-width="1.8" stroke-linejoin="round"></polygon>
          <polygon points="128,152 128,110 164,110 164,44 216,44 216,110 252,110 252,152" fill="#080b12" stroke="rgba(150,180,210,0.7)" stroke-width="1.6" stroke-dasharray="5 4" stroke-linejoin="round"></polygon>
          <polygon points="116,128 116,140 74,137 74,131" fill="oklch(0.72 0.16 30)" opacity="0.5" stroke="oklch(0.72 0.16 30)" stroke-width="1.4"></polygon>
          <polygon points="264,128 264,140 306,137 306,131" fill="oklch(0.72 0.16 30)" opacity="0.5" stroke="oklch(0.72 0.16 30)" stroke-width="1.4"></polygon>
          <line x1="190" y1="24" x2="190" y2="172" stroke="rgba(150,180,210,0.45)" stroke-width="1.2" stroke-dasharray="12 4 3 4"></line>
          <text x="310" y="122" font-family="IBM Plex Sans, sans-serif" font-size="11.5" fill="oklch(0.75 0.14 30)">výronek</text>
          <text x="190" y="196" font-family="IBM Plex Sans, sans-serif" font-size="11.5" fill="oklch(0.75 0.14 30)" text-anchor="middle">šrafa = přídavek 1,5–3 mm</text>
          <text x="106" y="60" font-family="IBM Plex Sans, sans-serif" font-size="11.5" fill="#8296a8" text-anchor="end">úkos 3–7°</text>
          <text x="106" y="102" font-family="IBM Plex Sans, sans-serif" font-size="11.5" fill="#8296a8" text-anchor="end">IT12–IT14</text>
        </svg>
        <div style="font-size:14.5px;line-height:1.6;color:#aebfcf;margin-top:8px">Tvar je hotový, rozměr ne. Funkční plochy se dokončují obráběním, výronek se ostřihuje.</div>
      </div>

      <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(123,163,204,0.28);border-radius:16px;padding:20px 22px 18px">
        <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:13px;letter-spacing:0.05em;text-transform:uppercase;color:#7ba3cc;margin-bottom:14px">Protlaček — za studena</div>
        <svg viewBox="0 0 380 210" style="width:100%;display:block">
          <polygon points="128,152 128,110 164,110 164,44 216,44 216,110 252,110 252,152" fill="rgba(123,163,204,0.14)" stroke="#7ba3cc" stroke-width="1.8" stroke-linejoin="round"></polygon>
          <line x1="190" y1="24" x2="190" y2="172" stroke="rgba(150,180,210,0.45)" stroke-width="1.2" stroke-dasharray="12 4 3 4"></line>
          <text x="190" y="196" font-family="IBM Plex Sans, sans-serif" font-size="11.5" fill="#7ba3cc" text-anchor="middle">bez přídavku — hotový rozměr</text>
          <text x="224" y="36" font-family="IBM Plex Sans, sans-serif" font-size="11.5" fill="#8296a8">bez úkosů</text>
          <text x="120" y="102" font-family="IBM Plex Sans, sans-serif" font-size="11.5" fill="#8296a8" text-anchor="end">IT7–IT9, Ra 0,4–1,6</text>
        </svg>
        <div style="font-size:14.5px;line-height:1.6;color:#aebfcf;margin-top:8px">Rozměr i povrch vycházejí z nástroje. Obrábí se jen tam, kde je předepsán závit nebo užší tolerance.</div>
      </div>
    </div>
    <p style="font-size:14.5px;line-height:1.65;color:#8296a8;margin:0 0 34px">Přídavek se platí dvakrát: jednou jako materiál, který se koupí a ohřeje, podruhé jako strojní čas, kterým se odebere. U velkých sérií to rozhoduje víc než cena nástroje.</p>

    <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:22px;color:#eaf2fa;margin:0 0 8px">Kdy co zvolit<br></div>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 18px">Rozhodují čtyři věci. Zpravidla nejdřív velikost dílu — velký kus za studena prostě neutvářím, protože potřebná síla roste s plochou i s pevností zpevněného materiálu.</p>

    <div style="display:grid;grid-template-columns:170px 1fr 1fr;gap:1px;background:rgba(150,180,210,0.16);border:1px solid rgba(150,180,210,0.16);border-radius:14px;overflow:hidden;margin:0 0 20px">
      <div style="background:#0d121a;padding:14px 16px;font-family:'Quicksand',sans-serif;font-weight:600;font-size:12px;letter-spacing:0.05em;text-transform:uppercase;color:#8296a8">Kritérium</div>
      <div style="background:#0d121a;padding:14px 16px;font-family:'Quicksand',sans-serif;font-weight:600;font-size:13.5px;color:oklch(0.75 0.14 30)">Volím za tepla</div>
      <div style="background:#0d121a;padding:14px 16px;font-family:'Quicksand',sans-serif;font-weight:600;font-size:13.5px;color:#7ba3cc">Volím za studena</div>

      <div style="background:#0d121a;padding:14px 16px;font-size:13.5px;color:#8296a8">Velikost dílu</div>
      <div style="background:#0d121a;padding:14px 16px;font-size:14.5px;line-height:1.5;color:#eaf2fa">Nad několik kilogramů, hřídele, ojnice, klikové hřídele, kovářské ingoty.</div>
      <div style="background:#0d121a;padding:14px 16px;font-size:14.5px;line-height:1.5;color:#eaf2fa">Drobné díly do zhruba 1 kg, plechy do několika mm.</div>

      <div style="background:#0d121a;padding:14px 16px;font-size:13.5px;color:#8296a8">Velikost série</div>
      <div style="background:#0d121a;padding:14px 16px;font-size:14.5px;line-height:1.5;color:#eaf2fa">Kusová i sériová; volné kování zvládne i jeden kus.</div>
      <div style="background:#0d121a;padding:14px 16px;font-size:14.5px;line-height:1.5;color:#eaf2fa">Velké série — drahý nástroj se rozpustí až v desítkách tisíc kusů.</div>

      <div style="background:#0d121a;padding:14px 16px;font-size:13.5px;color:#8296a8">Požadovaná přesnost</div>
      <div style="background:#0d121a;padding:14px 16px;font-size:14.5px;line-height:1.5;color:#eaf2fa">Když se stejně bude obrábět — přesnost nemá cenu platit dvakrát.</div>
      <div style="background:#0d121a;padding:14px 16px;font-size:14.5px;line-height:1.5;color:#eaf2fa">Když má díl jít z lisu rovnou k montáži.</div>

      <div style="background:#0d121a;padding:14px 16px;font-size:13.5px;color:#8296a8">Materiál a tvar</div>
      <div style="background:#0d121a;padding:14px 16px;font-size:14.5px;line-height:1.5;color:#eaf2fa">Vysoká pevnost, malá tvárnost za studena, velké přetvoření v jedné operaci.</div>
      <div style="background:#0d121a;padding:14px 16px;font-size:14.5px;line-height:1.5;color:#eaf2fa">Dobře tvárné oceli a neželezné kovy; zpevnění je vítaný efekt.</div>
    </div>

    <div style="background:rgba(214,176,120,0.07);border:1px solid rgba(214,176,120,0.28);border-radius:14px;padding:20px 24px;margin:0 0 30px">
      <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:12.5px;letter-spacing:0.05em;text-transform:uppercase;color:oklch(0.78 0.11 80);margin-bottom:8px">Mezi tím — tváření za poloohřevu</div>
      <p style="font-size:15.5px;line-height:1.65;color:#aebfcf;margin:0 0 10px;text-wrap:pretty">Ohřev jen na zhruba 550–850 °C — nad rekrystalizační teplotou, ale pod pásmem intenzivní tvorby okují a pod přeměnou A1. Rekrystalizace proběhne jen částečně, takže si díl část zpevnění ponechá. Přetvárný odpor klesne na zlomek hodnoty za studena, takže lze udělat větší přetvoření v jedné operaci, přitom okuje vznikají jen minimálně a rozměr zůstane v IT10–IT12.</p>
      <p style="font-size:15.5px;line-height:1.65;color:#aebfcf;margin:0">Používá se hlavně u ocelí, které se za studena protlačovat nedají, a u dílů, kde by kování za tepla dalo příliš velký přídavek — ozubená kola, kalíšky, čepy převodovek. Za to se platí ohřevem a kratší životností nástrojů, které pracují za horka i pod vysokým tlakem.</p>
    </div>

    <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:14px;padding:18px 22px">
      <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;color:#7ba3cc;margin-bottom:6px">Shrnutí</div>
      <div style="font-size:14.5px;line-height:1.6;color:#aebfcf">Za tepla se vyrábí tvar, za studena rozměr. Ohřátý kov jde tvářet snadno, ale s přídavkem; studený drží toleranci a povrch, zaplatí se to silou stroje, cenou nástroje a omezenou velikostí dílu.</div>
    </div>
  </div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script>
const IT_MIN = 5, IT_MAX = 16, IT_SPAN = IT_MAX - IT_MIN + 1;
const PAL = {
  hot:  { dot: 'oklch(0.72 0.16 30)', bg: 'rgba(224,140,110,0.28)', bgOn: 'rgba(224,140,110,0.5)',  border: 'rgba(224,140,110,0.6)' },
  warm: { dot: 'oklch(0.82 0.13 100)', bg: 'rgba(196,186,96,0.26)', bgOn: 'rgba(196,186,96,0.52)',  border: 'rgba(196,186,96,0.62)' },
  cold: { dot: '#7ba3cc',             bg: 'rgba(123,163,204,0.28)', bgOn: 'rgba(123,163,204,0.55)', border: 'rgba(123,163,204,0.62)' },
  mach: { dot: 'rgba(150,180,210,0.5)', bg: 'rgba(150,180,210,0.12)', bgOn: 'rgba(150,180,210,0.24)', border: 'rgba(150,180,210,0.35)' },
};

const DATA = [
  { id: 'volne', g: 'hot', name: 'Volné kování', it: [14, 16], ra: [25, 100], raTxt: '25–100', pridavek: '5–15 mm',
    dily: 'Rotory, hřídele lodí, kovářské ingoty', note: 'Tvar dává kovář údery bucharu, ne dutina nástroje. Rozměr proto vychází z ruky a měřidla — na obrábění se nechává největší přídavek ze všech technologií.' },
  { id: 'valcovani', g: 'hot', name: 'Válcování za tepla', it: [13, 15], ra: [12.5, 50], raTxt: '12,5–50', pridavek: 'dáno normou tyče',
    dily: 'Tyče, profily, plechy, kolejnice', note: 'Rozměr drží kalibr válců, ale okuje a smrštění při chladnutí posunou výsledek. Tolerance válcovaných tyčí předepisuje norma, ne konstruktér.' },
  { id: 'zapustka', g: 'hot', name: 'Zápustkové kování', it: [12, 14], ra: [12.5, 25], raTxt: '12,5–25', pridavek: '1,5–3 mm',
    dily: 'Ojnice, klikové hřídele, páky, háky', note: 'Nejběžnější kovací technologie. Tvar je věrný dutině zápustky, přesnost snižuje opotřebení zápustky, výronek a smrštění výkovku o zhruba 1,2 %.' },
  { id: 'presna-zapustka', g: 'hot', name: 'Přesné zápustkové kování', it: [9, 11], ra: [3.2, 12.5], raTxt: '3,2–12,5', pridavek: '0–0,5 mm',
    dily: 'Ozubená kola s kovaným zubem, lopatky', note: 'Kování v uzavřené zápustce bez výronku, s ohřevem v ochranné atmosféře. Funkční plochy vyjdou téměř načisto, ale nástroj i seřízení jsou výrazně dražší.' },
  { id: 'polotepla', g: 'warm', name: 'Tváření za poloohřevu', it: [10, 12], ra: [3.2, 6.3], raTxt: '3,2–6,3', pridavek: '0,3–1 mm',
    dily: 'Ozubená kola, kalíšky, čepy převodovek', note: 'Ohřev na 550–850 °C: okuje vznikají jen minimálně a kov klade podstatně menší odpor než za studena. Kompromis mezi přesností a potřebnou silou.' },
  { id: 'strihani', g: 'cold', name: 'Stříhání', it: [11, 13], ra: [3.2, 12.5], raTxt: '3,2–12,5 (střižná plocha)', pridavek: 'okraj se často obrábí',
    dily: 'Výstřižky z plechu, podložky, lamely', note: 'Rozměr obrysu drží střižník dobře, horší je střižná plocha — jen část je hladká, zbytek je utržený a doprovází ho otřep.' },
  { id: 'presne-strihani', g: 'cold', name: 'Přesné stříhání', it: [7, 9], ra: [0.4, 1.6], raTxt: '0,4–1,6', pridavek: 'bez přídavku',
    dily: 'Ozubené segmenty, západky, kotouče brzd', note: 'Tlačná hrana a protitlak drží materiál stlačený, takže se plocha nepřetrhne a je hladká po celé tloušťce. Nahrazuje stříhání i následné obrábění obrysu.' },
  { id: 'ohybani', g: 'cold', name: 'Ohýbání', it: [11, 13], ra: [1.6, 6.3], raTxt: '1,6–6,3 (povrch plechu)', pridavek: 'bez přídavku',
    dily: 'Konzoly, profily, U-třmeny, plechové skříně', note: 'Povrch zůstává takový, jaký byl na plechu. Přesnost úhlu snižuje odpružení — kompenzuje se přeohnutím nebo kalibrací na dně zdvihu.' },
  { id: 'tazeni', g: 'cold', name: 'Hluboké tažení', it: [9, 12], ra: [0.8, 3.2], raTxt: '0,8–3,2', pridavek: 'okraj se ostřihává',
    dily: 'Karoserie, plechovky, vany, kryty', note: 'Průměr a hloubka jsou přesné, problém dělá okraj: cípatost od anizotropie plechu se zarovnává ostřižením, na které se nechává přídavek.' },
  { id: 'protlacovani', g: 'cold', name: 'Protlačování za studena', it: [7, 9], ra: [0.4, 1.6], raTxt: '0,4–1,6', pridavek: 'bez přídavku',
    dily: 'Pouzdra, čepy, hlavy šroubů, pístky', note: 'Rozměr i lesklý povrch přebírá díl z nástroje. Vlákna zůstávají spojitá a materiál je zpevněný, takže díl je pevnější než obrobený z tyče.' },
  { id: 'tazeni-tyci', g: 'cold', name: 'Tažení tyčí a drátu', it: [8, 10], ra: [0.4, 1.6], raTxt: '0,4–1,6', pridavek: 'bez přídavku',
    dily: 'Tažené tyče h9, dráty, trubky', note: 'Průvlak zmenší průřez za studena. Tažená tyč se dodává v toleranci h9 s hladkým povrchem, takže se na automatech obrábí jen tam, kde je potřeba tvar.' },
  { id: 'soustruzeni', g: 'mach', name: 'Soustružení načisto', it: [7, 9], ra: [0.8, 3.2], raTxt: '0,8–3,2', pridavek: '—',
    dily: 'Srovnávací hodnota', note: 'Pro srovnání: běžné dokončovací soustružení se pohybuje na stejné úrovni jako protlačování za studena — jen se u něj materiál odebírá, místo aby se přemístil.' },
  { id: 'brouseni', g: 'mach', name: 'Broušení', it: [5, 7], ra: [0.1, 0.8], raTxt: '0,1–0,8', pridavek: '—',
    dily: 'Srovnávací hodnota', note: 'Pro srovnání: přesnost, kterou tváření nedosáhne. Uložení hřídelí v ložiskách proto zůstává úlohou pro brusku i na protlačovaném dílu.' },
];

function logPos(v) { return ((Math.log10(v) + 1) / 3) * 100; }

class Component extends DCLogic {
  state = { sel: 'zapustka' };
  renderVals() {
    const sel = this.state.sel;
    const rows = DATA.map(d => {
      const p = PAL[d.g], on = d.id === sel;
      return {
        name: d.name,
        dot: p.dot,
        labelColor: on ? '#eaf2fa' : '#aebfcf',
        labelWeight: on ? '600' : '400',
        left: ((d.it[0] - IT_MIN) / IT_SPAN * 100).toFixed(2) + '%',
        width: ((d.it[1] - d.it[0] + 1) / IT_SPAN * 100).toFixed(2) + '%',
        bg: on ? p.bgOn : p.bg,
        border: on ? p.border : 'transparent',
        rangeColor: on ? '#f2f7fc' : '#c4d2de',
        range: 'IT' + d.it[0] + '–IT' + d.it[1],
        select: () => this.setState({ sel: d.id }),
      };
    });
    const d = DATA.find(x => x.id === sel) || DATA[0];
    const p = PAL[d.g];
    return {
      rows,
      sel: {
        name: d.name, note: d.note, ra: d.raTxt + ' µm', pridavek: d.pridavek, dily: d.dily,
        bg: p.bgOn, border: p.border,
        raLeft: logPos(d.ra[0]).toFixed(2) + '%',
        raWidth: (logPos(d.ra[1]) - logPos(d.ra[0])).toFixed(2) + '%',
      },
    };
  }
}

(function () {
  const P = '../../';
  const FALLBACK_NAV = [{ title: 'Domů', href: '../../index.html' }, { title: 'Vnitřní stavba kovů a TZ', href: '../../vnitrni-stavba-kovu-a-tz/index.html?view=home' }, { title: 'Koroze', href: '../../koroze/index.html' }, { title: 'Tváření', href: '../../tvareni-za-tepla/index.html' }, { title: 'O projektu', href: '../../o-projektu.html' }, { title: 'Novinky', href: '../../novinky.html' }];
  const rv = Component.prototype.renderVals;
  Component.prototype.renderVals = function () {
    const base = rv ? (rv.call(this) || {}) : {};
    const n = this.state && this.state.__nav;
    const navItems = n ? n.map(i => ({ title: i.title, href: P + i.href })) : FALLBACK_NAV;
    return Object.assign({}, base, { navItems });
  };
  const cdm = Component.prototype.componentDidMount;
  Component.prototype.componentDidMount = function () {
    if (cdm) cdm.call(this);
    fetch(P + 'site-structure.json').then(r => r.json()).then(s => this.setState({ __nav: s.nav })).catch(() => {});
  };
})();
</script>
</body>
</html>
