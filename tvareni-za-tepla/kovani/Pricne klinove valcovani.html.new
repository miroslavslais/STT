<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Příčné klínové válcování | STT</title>
<meta name="description" content="Animace příčného klínového válcování: z válce stupňovitý předkovek ojnice a rozvinutý profil klínu.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23fbf8f3'/%3E%3Ctext x='12' y='17' font-family='Georgia,serif' font-size='12' font-weight='700' fill='%23b0561f' text-anchor='middle'%3ES%3C/text%3E%3C/svg%3E">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <script defer src="https://cloud.umami.is/script.js" data-website-id="4c272434-8fc9-49a9-9a2c-b3e710506cae"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>html, body { margin: 0; background: #080b12; } a { color: inherit; text-decoration: none; } input[type=range] { accent-color: #e6a94a; }</style>
  <script>
    document.addEventListener('mouseover', function(e){ var el = e.target.closest('.site-nav-toggle'); if (el) el.style.maxHeight = el.scrollHeight + 'px'; });
    document.addEventListener('mouseout', function(e){ var el = e.target.closest('.site-nav-toggle'); if (el && !el.contains(e.relatedTarget)) el.style.maxHeight = '48px'; });
    (function __navSync(){
      fetch('../../site-structure.json').then(function(r){return r.json();}).then(function(s){
        var links = document.querySelectorAll('.site-nav-toggle a');
        var SELF = 'tvareni-za-tepla/';
        s.nav.forEach(function(item, i){
          var href = item.href.indexOf(SELF) === 0 ? '../' + item.href.slice(SELF.length) : '../../' + item.href;
          var el = links[i];
          if (el) { el.textContent = item.title; el.setAttribute('href', href); }
        });
      }).catch(function(){});
    })();
  </script>
</helmet>
<div class="site-nav-toggle" style="position:fixed;top:24px;right:24px;z-index:1000;width:220px;background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;box-shadow:0 2px 10px rgba(35,29,22,0.08);overflow:hidden;max-height:48px;transition:max-height 0.22s ease">
  <div style="height:48px;display:flex;align-items:center;justify-content:center;gap:5px;flex-direction:column;cursor:pointer">
    <span style="width:20px;height:2px;background:#5c5346;border-radius:1px"></span>
    <span style="width:20px;height:2px;background:#5c5346;border-radius:1px"></span>
    <span style="width:20px;height:2px;background:#5c5346;border-radius:1px"></span>
  </div>
  <div style="display:flex;flex-direction:column;border-top:1px solid #eee5d8">
    <sc-for list="{{ navItems }}" as="n" hint-placeholder-count="6">
      <a href="{{ n.href }}" style="padding:12px 18px;font-family:'Quicksand',sans-serif;font-weight:600;font-size:14px;color:#eaf2fa" style-hover="background:#fbf8f3">{{ n.title }}</a>
    </sc-for>
  </div>
</div>
<a href="index.html" style="position:fixed;top:16px;left:16px;z-index:1000;display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,0.08);backdrop-filter:blur(6px);color:#e8ecf3;font-family:'IBM Plex Sans',sans-serif;font-size:14px;font-weight:500;border:1px solid rgba(255,255,255,0.14)">← Zpět na Kování</a>

<div style="min-height:100vh;background:#080b12;font-family:'IBM Plex Sans',sans-serif;padding:78px 48px 80px;box-sizing:border-box;color:#eaf2fa">
  <div style="max-width:1120px;margin:0 auto">
    <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:13.5px;letter-spacing:0.06em;text-transform:uppercase;color:oklch(0.72 0.15 60);margin-bottom:8px">Válcování</div>
    <h1 style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:34px;line-height:1.2;color:#eaf2fa;margin:0 0 20px">Příčné klínové válcování</h1>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;max-width:820px;margin:0 0 24px">Válcový polotovar se mezi dvěma nástroji s klíny <strong>jen otáčí kolem své osy</strong> (neposouvá se axiálně). Klíny se postupně zaříznou a bočně rozhánějí materiál — z hladkého válce vzniká v jednom „průchodu“ stupňovitý předkovek ojnice. Nástroje jsou přitom v <strong>trvalém kontaktu</strong> po celé délce, takže jejich pracovní profil se plynule mění.</p>

    <div style="background:#080b12;border:1px solid rgba(150,180,210,0.16);border-radius:16px;overflow:hidden;padding:18px 18px 12px;display:flex;gap:16px;align-items:stretch">
      <div style="flex:1;min-width:0">{{ frame }}</div>
      <div style="flex:0 0 196px;display:flex;flex-direction:column;border-left:1px solid rgba(150,180,210,0.12);padding-left:16px">
        <div style="flex:1;min-height:0">{{ devProfile }}</div>
        <div style="font-size:11.5px;line-height:1.4;color:#8ea2b6;text-align:center;font-family:'IBM Plex Mono',monospace;margin-top:6px">poloha na klínu = aktuální místo tváření</div>
      </div>
    </div>

    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:20px">
      <div onClick="{{ togglePlay }}" style="{{ playStyle }}">{{ playLabel }}</div>
      <div onClick="{{ restart }}" style="display:inline-flex;align-items:center;gap:7px;padding:11px 18px;border-radius:11px;cursor:pointer;font-family:'Quicksand',sans-serif;font-weight:600;font-size:14px;background:rgba(120,150,180,0.08);border:1px solid rgba(150,180,210,0.18);color:#aebfcf">↺ Od začátku</div>
      <input type="range" min="0" max="1000" value="{{ tThousand }}" onInput="{{ onScrub }}" style="flex:1;min-width:220px;height:6px">
    </div>

    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
      <sc-for list="{{ phaseBtns }}" as="b" hint-placeholder-count="5">
        <div onClick="{{ b.go }}" style="{{ b.style }}">{{ b.label }}</div>
      </sc-for>
    </div>

    <div style="display:flex;gap:16px;align-items:flex-start;margin-top:24px;padding:18px 22px;background:rgba(120,150,180,0.06);border:1px solid rgba(150,180,210,0.16);border-radius:16px">
      <div style="flex:0 0 auto;width:40px;height:40px;border-radius:11px;background:rgba(230,169,74,0.16);display:flex;align-items:center;justify-content:center;font-family:'Quicksand',sans-serif;font-weight:700;font-size:19px;color:#f2d79a">{{ phaseNum }}</div>
      <div>
        <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:18px;color:#eaf2fa;margin-bottom:4px">{{ phaseTitle }}</div>
        <div style="font-size:14.5px;line-height:1.55;color:#aebfcf;max-width:820px">{{ phaseDesc }}</div>
      </div>
    </div>

    <div style="display:flex;gap:22px;flex-wrap:wrap;margin-top:20px;font-size:13.5px;color:#aebfcf">
      <div style="display:flex;align-items:center;gap:8px"><span style="width:22px;height:12px;border-radius:3px;background:linear-gradient(#f7c948,#f0932b);display:inline-block"></span>ohřátý polotovar</div>
      <div style="display:flex;align-items:center;gap:8px"><span style="width:22px;height:12px;border-radius:3px;background:#4a5461;border:1px solid #5c6773;display:inline-block"></span>nástroj s klínem</div>
      <div style="display:flex;align-items:center;gap:8px"><span style="width:22px;height:0;border-top:2px dashed #6b7684;display:inline-block"></span>původní Ø válce</div>
      <div style="display:flex;align-items:center;gap:8px"><span style="width:22px;height:2px;background:#e6a94a;display:inline-block"></span>tok materiálu</div>
    </div>
  </div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:1120,&quot;height&quot;:980}}">
const R0 = 96, AX = 330, DL = 160, DR = 900, DUR = 12000;
const KP = [[0,92],[0.16,92],[0.22,42],[0.27,42],[0.33,52],[0.60,52],[0.66,42],[0.71,42],[0.76,72],[1,72]];
const PHASES = [
  { t: 0.03, n: 1, title: 'Výchozí stav', desc: 'Ohřátý válcový polotovar leží mezi horním a spodním nástrojem; klíny jsou v základní poloze a plochy nástrojů se dotýkají po celé délce.' },
  { t: 0.18, n: 2, title: 'Náběh klínu', desc: 'Hrany klínů se zaříznou do rotujícího polotovaru a vytvoří dva obvodové vruby v místech budoucích přechodů.' },
  { t: 0.50, n: 3, title: 'Rozhánění materiálu', desc: 'Klíny se rozšiřují; materiál se z vrubů axiálně rozhání do stran — průměry v zónách klesají a sousední úseky se prodlužují.' },
  { t: 0.80, n: 4, title: 'Kalibrace', desc: 'Ploché části nástroje dorovnají hotové průměry na cílový rozměr a tvar se ustálí na tři průřezy.' },
  { t: 1.00, n: 5, title: 'Hotový předkovek', desc: 'Stupňovitý předkovek ojnice: velké oko · dřík · malé oko — připravený pro následné zápustkové kování.' },
];

class Component extends DCLogic {
  state = { t: 0, playing: true };

  componentDidMount() {
    this._last = performance.now();
    const tick = (now) => {
      const dt = (now - this._last) / DUR; this._last = now;
      if (this.state.playing) { let t = this.state.t + dt; if (t >= 1) t = 0; this.setState({ t }); }
      this._raf = requestAnimationFrame(tick);
    };
    this._raf = requestAnimationFrame(tick);
  }
  componentWillUnmount() { cancelAnimationFrame(this._raf); }

  smooth(a, b, x) { let t = Math.max(0, Math.min(1, (x - a) / (b - a))); return t * t * (3 - 2 * t); }
  interpT(s) {
    for (let i = 1; i < KP.length; i++) {
      if (s <= KP[i][0]) { const a = KP[i - 1], b = KP[i]; const u = (s - a[0]) / ((b[0] - a[0]) || 1); return a[1] + (b[1] - a[1]) * u; }
    }
    return KP[KP.length - 1][1];
  }
  phaseOf(t) {
    if (t < 0.06) return PHASES[0];
    if (t < 0.30) return PHASES[1];
    if (t < 0.68) return PHASES[2];
    if (t < 0.90) return PHASES[3];
    return PHASES[4];
  }

  frame(t) {
    const h = React.createElement;
    const f = this.smooth(0.06, 0.92, t);
    const ease = Math.pow(f, 0.82);
    const rad = (s) => { s = Math.max(0, Math.min(1, s)); return R0 - (R0 - this.interpT(s)) * ease; };
    const eOff = 72 * ease;
    const left = 180 - eOff, right = 880 + eOff, span = right - left;
    const mapX = (s) => left + s * span;
    const radAtX = (x) => rad((x - left) / span);
    const spin = t * 360 * 6, spr = spin * Math.PI / 180;

    // billet outline
    const N = 150; const top = [], bot = [];
    for (let i = 0; i <= N; i++) { const s = i / N, x = mapX(s), r = rad(s); top.push(x.toFixed(1) + ' ' + (AX - r).toFixed(1)); bot.push(x.toFixed(1) + ' ' + (AX + r).toFixed(1)); }
    const billetD = 'M' + top.join(' L') + ' L' + bot.slice().reverse().join(' L') + ' Z';

    // die faces (constant contact with current profile)
    const M = 120; const fT = [], fB = [];
    for (let j = 0; j <= M; j++) { const x = DL + (DR - DL) * j / M; const r = radAtX(x); fT.push([x, AX - r]); fB.push([x, AX + r]); }
    const dieTopD = 'M' + DL + ' 88 L' + DR + ' 88 ' + fT.slice().reverse().map(p => 'L' + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ') + ' Z';
    const dieBotD = 'M' + DL + ' 572 L' + DR + ' 572 ' + fB.slice().reverse().map(p => 'L' + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ') + ' Z';

    const els = [];
    els.push(h('defs', { key: 'defs' }, [
      h('linearGradient', { key: 'hot', id: 'pkvHot', x1: 0, y1: 0, x2: 0, y2: 1 }, [
        h('stop', { key: 0, offset: '0', stopColor: '#ffe08a' }), h('stop', { key: 1, offset: '0.5', stopColor: '#f7c948' }), h('stop', { key: 2, offset: '1', stopColor: '#f0932b' })]),
      h('linearGradient', { key: 'tl', id: 'pkvTool', x1: 0, y1: 0, x2: 0, y2: 1 }, [
        h('stop', { key: 0, offset: '0', stopColor: '#525c67' }), h('stop', { key: 1, offset: '1', stopColor: '#3a424c' })]),
      h('marker', { key: 'fl', id: 'pkvFlow', viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 7, markerHeight: 7, orient: 'auto-start-reverse' }, h('path', { d: 'M0 0 L10 5 L0 10 z', fill: '#e6a94a' })),
      h('radialGradient', { key: 'glow', id: 'pkvGlow', cx: '0.5', cy: '0.46', r: '0.62' }, [h('stop', { key: 0, offset: '0', stopColor: 'rgba(58,40,22,0.35)' }), h('stop', { key: 1, offset: '1', stopColor: 'rgba(9,13,20,0)' })]),
    ]));
    els.push(h('rect', { key: 'glow', x: 0, y: 0, width: 1080, height: 640, fill: 'url(#pkvGlow)' }));

    // original diameter envelope
    const envOp = 0.35 + 0.45 * f;
    els.push(h('line', { key: 'e1', x1: 180, y1: AX - R0, x2: 880, y2: AX - R0, stroke: '#6b7684', strokeWidth: 1.6, strokeDasharray: '7 7', opacity: envOp }));
    els.push(h('line', { key: 'e2', x1: 180, y1: AX + R0, x2: 880, y2: AX + R0, stroke: '#6b7684', strokeWidth: 1.6, strokeDasharray: '7 7', opacity: envOp }));
    els.push(h('text', { key: 'et', x: 892, y: AX - R0 + 4, fontFamily: 'IBM Plex Sans, sans-serif', fontSize: 13, fill: '#8ea2b6', opacity: envOp }, 'původní Ø'));

    // dies
    els.push(h('path', { key: 'dt', d: dieTopD, fill: 'url(#pkvTool)', stroke: '#737f8c', strokeWidth: 2, strokeLinejoin: 'round' }));
    els.push(h('path', { key: 'db', d: dieBotD, fill: 'url(#pkvTool)', stroke: '#737f8c', strokeWidth: 2, strokeLinejoin: 'round' }));
    els.push(h('text', { key: 'dtl', x: 530, y: 118, textAnchor: 'middle', fontFamily: 'Quicksand, sans-serif', fontWeight: 600, fontSize: 16, fill: '#9fb2c4' }, 'horní nástroj (klíny)'));
    els.push(h('text', { key: 'dbl', x: 530, y: 556, textAnchor: 'middle', fontFamily: 'Quicksand, sans-serif', fontWeight: 600, fontSize: 16, fill: '#9fb2c4' }, 'spodní nástroj (klíny)'));

    // billet
    els.push(h('path', { key: 'bil', d: billetD, fill: 'url(#pkvHot)', stroke: '#ffce6a', strokeWidth: 2.5, strokeLinejoin: 'round' }));
    // axis
    els.push(h('line', { key: 'ax', x1: 90, y1: AX, x2: 960, y2: AX, stroke: '#5c6773', strokeWidth: 1.4, strokeDasharray: '10 6' }));

    // flow arrows at necks
    const fOp = this.smooth(0.12, 0.42, f) * (1 - this.smooth(0.74, 0.94, f));
    if (fOp > 0.02) {
      [0.245, 0.685].forEach((sc, k) => {
        const nx = mapX(sc);
        els.push(h('line', { key: 'fa' + k, x1: nx - 16, y1: AX, x2: nx - 92, y2: AX, stroke: '#e6a94a', strokeWidth: 4, markerEnd: 'url(#pkvFlow)', opacity: fOp }));
        els.push(h('line', { key: 'fb' + k, x1: nx + 16, y1: AX, x2: nx + 92, y2: AX, stroke: '#e6a94a', strokeWidth: 4, markerEnd: 'url(#pkvFlow)', opacity: fOp }));
      });
    }

    // rotating end face (left)
    const rE = rad(0);
    els.push(h('ellipse', { key: 'ef', cx: left, cy: AX, rx: 13, ry: rE, fill: '#f0932b', stroke: '#ffce6a', strokeWidth: 2 }));
    const dY = (rE - 10) * Math.sin(spr);
    els.push(h('ellipse', { key: 'ed1', cx: left, cy: AX + dY, rx: 5, ry: 5, fill: '#fff2e2', opacity: 0.9 }));
    els.push(h('ellipse', { key: 'ed2', cx: left, cy: AX - dY, rx: 4, ry: 4, fill: '#b85e1e', opacity: 0.8 }));
    // rotation glyph
    const gx = left - 6, gy = AX - rE - 30;
    els.push(h('path', { key: 'rg', d: 'M' + (gx - 13) + ' ' + gy + ' A13 13 0 1 1 ' + (gx - 4) + ' ' + (gy + 12), fill: 'none', stroke: '#eaf2fa', strokeWidth: 2.4, transform: 'rotate(' + (spin % 360) + ' ' + gx + ' ' + gy + ')' }));
    els.push(h('path', { key: 'rgh', d: 'M' + (gx - 8) + ' ' + (gy + 14) + ' l4 -2 -1 5 z', fill: '#eaf2fa', transform: 'rotate(' + (spin % 360) + ' ' + gx + ' ' + gy + ')' }));
    els.push(h('text', { key: 'rgt', x: gx, y: gy - 20, textAnchor: 'middle', fontFamily: 'IBM Plex Sans, sans-serif', fontSize: 13, fill: '#aebfcf' }, 'rotace'));

    // vrub callout (during knife edge onward)
    if (f > 0.06 && f < 0.9) {
      const nx = mapX(0.245);
      els.push(h('line', { key: 'vl', x1: nx, y1: 196, x2: nx, y2: AX - rad(0.245) - 4, stroke: '#6b7684', strokeWidth: 1.3, strokeDasharray: '3 3', opacity: 0.8 }));
      els.push(h('rect', { key: 'vr', x: nx - 58, y: 172, width: 116, height: 26, rx: 6, fill: 'rgba(20,26,34,0.92)', stroke: 'rgba(150,180,210,0.22)', strokeWidth: 1.2 }));
      els.push(h('text', { key: 'vt', x: nx, y: 189, textAnchor: 'middle', fontFamily: 'IBM Plex Sans, sans-serif', fontSize: 13, fill: '#aebfcf' }, 'klín — vrub'));
    }

    // zone labels
    const zOp = this.smooth(0.55, 0.82, f);
    if (zOp > 0.02) {
      [[0.09, 'velké oko'], [0.46, 'dřík'], [0.87, 'malé oko']].forEach((z, k) => {
        els.push(h('text', { key: 'z' + k, x: mapX(z[0]), y: AX + 4, textAnchor: 'middle', fontFamily: 'Quicksand, sans-serif', fontWeight: 700, fontSize: 14.5, fill: '#fff', opacity: zOp }, z[1]));
      });
    }

    return h('svg', { viewBox: '0 0 1080 640', style: { width: '100%', height: 'auto' } }, els);
  }

  devFrame(t) {
    const h = React.createElement;
    const VW = 200, VH = 560, cx = 90, y0 = 62, y1 = 512;
    const KW = [[0, 2], [0.06, 5], [0.30, 26], [0.68, 50], [0.90, 46], [1, 46]];
    const wAt = (p) => { p = Math.max(0, Math.min(1, p)); for (let i = 1; i < KW.length; i++) { if (p <= KW[i][0]) { const a = KW[i - 1], b = KW[i], u = (p - a[0]) / ((b[0] - a[0]) || 1); return a[1] + (b[1] - a[1]) * u; } } return KW[KW.length - 1][1]; };
    const yOf = (p) => y0 + p * (y1 - y0);
    const N = 90, L = [], R = [];
    for (let i = 0; i <= N; i++) { const p = i / N, y = yOf(p), w = wAt(p); L.push(cx - w); R.push(cx + w); }
    const wedgeD = 'M' + L.map((x, i) => x.toFixed(1) + ' ' + yOf(i / N).toFixed(1)).join(' L') + ' L' + R.map((x, i) => x.toFixed(1) + ' ' + yOf(i / N).toFixed(1)).reverse().join(' L') + ' Z';
    const els = [];
    els.push(h('defs', { key: 'd' }, [
      h('linearGradient', { key: 'g', id: 'devWedge', x1: 0, y1: 0, x2: 1, y2: 0 }, [
        h('stop', { key: 0, offset: '0', stopColor: '#3a424c' }), h('stop', { key: 1, offset: '0.5', stopColor: '#6a7683' }), h('stop', { key: 2, offset: '1', stopColor: '#3a424c' })]),
    ]));
    els.push(h('text', { key: 'ti', x: cx, y: 22, textAnchor: 'middle', fontFamily: 'Quicksand, sans-serif', fontWeight: 600, fontSize: 14, fill: '#eaf2fa' }, 'Rozvinutý klín'));
    els.push(h('text', { key: 'ti2', x: cx, y: 40, textAnchor: 'middle', fontFamily: 'IBM Plex Mono, monospace', fontSize: 10.5, fill: '#8ea2b6' }, 'směr válcování ↓'));
    els.push(h('rect', { key: 'blk', x: cx - 66, y: y0 - 12, width: 132, height: (y1 - y0) + 24, rx: 12, fill: 'rgba(120,150,180,0.05)', stroke: 'rgba(150,180,210,0.14)', strokeWidth: 1 }));
    const zones = [[0.06, 0.30, 'náběh'], [0.30, 0.68, 'rozhánění'], [0.68, 1.0, 'kalibrace']];
    zones.forEach((z, k) => {
      const ya = yOf(z[0]), yb = yOf(z[1]), ym = (ya + yb) / 2;
      if (k > 0) els.push(h('line', { key: 'zl' + k, x1: cx - 66, y1: ya, x2: cx + 66, y2: ya, stroke: 'rgba(150,180,210,0.14)', strokeWidth: 1, strokeDasharray: '3 4' }));
      els.push(h('text', { key: 'zt' + k, x: cx + 60, y: ym, textAnchor: 'middle', fontFamily: 'IBM Plex Mono, monospace', fontSize: 10.5, fill: '#8ea2b6', transform: 'rotate(90 ' + (cx + 60) + ' ' + ym + ')' }, z[2]));
    });
    els.push(h('line', { key: 'cl', x1: cx, y1: y0 - 12, x2: cx, y2: y1 + 12, stroke: '#5c6773', strokeWidth: 1.2, strokeDasharray: '8 6' }));
    els.push(h('path', { key: 'wg', d: wedgeD, fill: 'url(#devWedge)', stroke: '#8fa0b3', strokeWidth: 1.4, strokeLinejoin: 'round' }));
    els.push(h('circle', { key: 'kn', cx: cx, cy: y0, r: 2.6, fill: '#8fa0b3' }));
    els.push(h('text', { key: 'knt', x: cx + 10, y: y0 + 2, fontFamily: 'IBM Plex Mono, monospace', fontSize: 10, fill: '#9fb2c4' }, 'ostří'));
    // marker at current t
    const ym = yOf(Math.max(0, Math.min(1, t))), wm = wAt(t);
    els.push(h('line', { key: 'mk', x1: cx - 74, y1: ym, x2: cx + 74, y2: ym, stroke: '#e6a94a', strokeWidth: 2 }));
    els.push(h('path', { key: 'mkp', d: 'M' + (cx - 82) + ' ' + (ym - 5) + ' L' + (cx - 74) + ' ' + ym + ' L' + (cx - 82) + ' ' + (ym + 5) + ' Z', fill: '#e6a94a' }));
    els.push(h('circle', { key: 'ml', cx: cx - wm, cy: ym, r: 3.4, fill: '#ffce6a', stroke: '#12161d', strokeWidth: 1 }));
    els.push(h('circle', { key: 'mr', cx: cx + wm, cy: ym, r: 3.4, fill: '#ffce6a', stroke: '#12161d', strokeWidth: 1 }));
    return h('svg', { viewBox: '0 0 ' + VW + ' ' + VH, preserveAspectRatio: 'xMidYMid meet', style: { width: '100%', height: '100%' } }, els);
  }

  renderVals() {
    const t = this.state.t, ph = this.phaseOf(t);
    const set = (nt) => this.setState({ t: nt, playing: false });
    const btnBase = 'padding:9px 15px;border-radius:10px;cursor:pointer;font-family:\'Quicksand\',sans-serif;font-weight:600;font-size:13.5px;transition:all .15s;';
    const phaseBtns = PHASES.map(p => {
      const active = ph.n === p.n;
      return {
        label: p.n + ' · ' + p.title.replace(/ \(.*\)/, ''),
        go: () => set(p.t),
        style: btnBase + (active
          ? 'background:rgba(230,169,74,0.16);border:1px solid rgba(230,169,74,0.5);color:#f2d79a;'
          : 'background:rgba(120,150,180,0.06);border:1px solid rgba(150,180,210,0.16);color:#8ea2b6;'),
      };
    });
    return {
      frame: this.frame(t),
      devProfile: this.devFrame(t),
      playing: this.state.playing,
      playLabel: this.state.playing ? '❙❙ Pauza' : '▶ Přehrát',
      playStyle: 'display:inline-flex;align-items:center;gap:7px;padding:11px 20px;border-radius:11px;cursor:pointer;font-family:\'Quicksand\',sans-serif;font-weight:700;font-size:14px;background:#e6a94a;border:1px solid #e6a94a;color:#12161d',
      togglePlay: () => this.setState(s => ({ playing: !s.playing })),
      restart: () => this.setState({ t: 0, playing: true }),
      tThousand: Math.round(t * 1000),
      onScrub: (e) => this.setState({ t: (+e.target.value) / 1000, playing: false }),
      phaseBtns, phaseNum: ph.n, phaseTitle: ph.title, phaseDesc: ph.desc,
    };
  }
}

(function () {
  const P = '../../';
  const FALLBACK_NAV = [{ title: 'Domů', href: '../../index.html' }, { title: 'Vnitřní stavba kovů a TZ', href: '../../vnitrni-stavba-kovu-a-tz/index.html?view=home' }, { title: 'Koroze', href: '../../koroze/index.html' }, { title: 'Tváření', href: '../../tvareni-za-tepla/index.html' }, { title: 'O projektu', href: '../../o-projektu.html' }, { title: 'Novinky', href: '../../novinky.html' }];
  const rv = Component.prototype.renderVals;
  Component.prototype.renderVals = function () {
    const base = rv ? (rv.call(this) || {}) : {};
    const n = this.state && this.state.__nav;
    const navItems = n ? n.map(i => ({ title: i.title, href: P + i.href })) : FALLBACK_NAV;
    return Object.assign({}, base, { navItems });
  };
  const cdm = Component.prototype.componentDidMount;
  Component.prototype.componentDidMount = function () {
    if (cdm) cdm.call(this);
    fetch(P + 'site-structure.json').then(r => r.json()).then(s => this.setState({ __nav: s.nav })).catch(() => {});
  };
})();
</script>
</body>
</html>
