<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Povrchové vady a pnutí | STT</title>
<meta name="description" content="Lüdersovy pásy, pomerančová kůra a zbytková pnutí projevující se až po čase.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23fbf8f3'/%3E%3Ctext x='12' y='17' font-family='Georgia,serif' font-size='12' font-weight='700' fill='%23b0561f' text-anchor='middle'%3ES%3C/text%3E%3C/svg%3E">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <script defer src="https://cloud.umami.is/script.js" data-website-id="4c272434-8fc9-49a9-9a2c-b3e710506cae"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>html, body { margin: 0; background: #080b12; } a { color: inherit; text-decoration: none; }</style>
  <script>
    document.addEventListener('mouseover', function(e){ var el = e.target.closest('.site-nav-toggle'); if (el) el.style.maxHeight = el.scrollHeight + 'px'; });
    document.addEventListener('mouseout', function(e){ var el = e.target.closest('.site-nav-toggle'); if (el && !el.contains(e.relatedTarget)) el.style.maxHeight = '48px'; });
  </script>
</helmet>
<div class="site-nav-toggle" style="position:fixed;top:24px;right:24px;z-index:1000;width:220px;background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;box-shadow:0 2px 10px rgba(35,29,22,0.08);overflow:hidden;max-height:48px;transition:max-height 0.22s ease">
  <div style="height:48px;display:flex;align-items:center;justify-content:center;gap:5px;flex-direction:column;cursor:pointer">
    <span style="width:20px;height:2px;background:#8296a8;border-radius:1px"></span>
    <span style="width:20px;height:2px;background:#8296a8;border-radius:1px"></span>
    <span style="width:20px;height:2px;background:#8296a8;border-radius:1px"></span>
  </div>
  <div style="display:flex;flex-direction:column;border-top:1px solid rgba(150,180,210,0.16)">
    <sc-for list="{{ navItems }}" as="n" hint-placeholder-count="6">
      <a href="{{ n.href }}" style="padding:12px 18px;font-family:'Quicksand',sans-serif;font-weight:600;font-size:14px;color:#eaf2fa" style-hover="background:rgba(150,180,210,0.08)">{{ n.title }}</a>
    </sc-for>
  </div>
</div>
<a href="index.html" style="position:fixed;top:16px;left:16px;z-index:1000;display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,0.08);backdrop-filter:blur(6px);color:#e8ecf3;font-family:'IBM Plex Sans',sans-serif;font-size:14px;font-weight:500;border:1px solid rgba(255,255,255,0.14)">← Zpět na Vady při tváření</a>

<div style="min-height:100vh;background:#080b12;font-family:'IBM Plex Sans',sans-serif;padding:78px 48px 80px;box-sizing:border-box;color:#eaf2fa">
  <div style="max-width:820px;margin:0 auto">
    <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:13.5px;letter-spacing:0.06em;text-transform:uppercase;color:#7ba3cc;margin-bottom:8px">Vady za studena</div>
    <h1 style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:34px;line-height:1.2;color:#eaf2fa;margin:0 0 20px">Povrchové vady a zbytková pnutí</h1>

    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 20px">Poslední skupina vad za studena se netýká tvaru, ale vzhledu povrchu a napjatosti, kterou si díl odnese z nástroje.</p>
    <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;padding:22px;margin:0 0 22px"><svg viewBox="0 0 720 230" width="100%" style="display:block">
  <rect x="30" y="30" width="200" height="130" rx="10" fill="rgba(120,150,180,0.06)" stroke="#7ba3cc" stroke-width="1.6"/>
  <g stroke="#7ba3cc" stroke-width="3" opacity="0.75"><path d="M50 150 L120 40"/><path d="M86 150 L156 40"/><path d="M122 150 L192 40"/><path d="M158 150 L214 62"/></g>
  <text x="130" y="186" text-anchor="middle" font-family="Quicksand,sans-serif" font-weight="700" font-size="15" fill="#7ba3cc">Lüdersovy pásy</text>
  <text x="130" y="208" text-anchor="middle" font-family="IBM Plex Sans,sans-serif" font-size="13" fill="#8296a8">pásy pod 45°, výrazná mez kluzu</text>
  <rect x="260" y="30" width="200" height="130" rx="10" fill="rgba(120,150,180,0.06)" stroke="#eda962" stroke-width="1.6"/>
  <g fill="none" stroke="#eda962" stroke-width="1.3" opacity="0.8">
    <circle cx="300" cy="62" r="16"/><circle cx="340" cy="90" r="19"/><circle cx="390" cy="58" r="17"/><circle cx="424" cy="98" r="15"/><circle cx="298" cy="126" r="18"/><circle cx="368" cy="134" r="16"/><circle cx="424" cy="146" r="13"/></g>
  <text x="360" y="186" text-anchor="middle" font-family="Quicksand,sans-serif" font-weight="700" font-size="15" fill="#eda962">Pomerančová kůra</text>
  <text x="360" y="208" text-anchor="middle" font-family="IBM Plex Sans,sans-serif" font-size="13" fill="#8296a8">hrubé zrno je vidět na povrchu</text>
  <rect x="490" y="30" width="200" height="130" rx="10" fill="rgba(120,150,180,0.06)" stroke="#e0655a" stroke-width="1.6"/>
  <path d="M520 120 Q590 60 660 120" fill="none" stroke="#e0655a" stroke-width="2.4"/>
  <path d="M520 96 Q590 36 660 96" fill="none" stroke="#8296a8" stroke-width="1.6" stroke-dasharray="5 4"/>
  <g stroke="#e0655a" stroke-width="1.6"><path d="M556 78 L556 60"/><path d="M624 78 L624 60"/></g>
  <text x="590" y="186" text-anchor="middle" font-family="Quicksand,sans-serif" font-weight="700" font-size="15" fill="#e0655a">Zbytková pnutí</text>
  <text x="590" y="208" text-anchor="middle" font-family="IBM Plex Sans,sans-serif" font-size="13" fill="#8296a8">díl se zdeformuje nebo praskne později</text>
</svg><div style="font-family:'IBM Plex Sans',sans-serif;font-size:13.5px;line-height:1.55;color:#8296a8;margin-top:14px">Tři vady, které se projeví až na hotovém dílu — dvě na povrchu, jedna se zpožděním.</div></div>
    <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:20px;color:#eaf2fa;margin:14px 0 10px">Lüdersovy pásy</div>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 20px">U měkkých ocelí s výraznou mezí kluzu se deformace nešíří plynule, ale po pásech nakloněných zhruba 45°. Povrch dostane viditelný reliéf, který je u pohledových dílů nepřijatelný. Řeší se dodatečným válcováním plechu s malým úběrem (dresírování) těsně před tvářením.</p>
    <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:20px;color:#eaf2fa;margin:14px 0 10px">Pomerančová kůra</div>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 20px">Hrubé zrno se při deformaci projeví na povrchu jako drsná struktura připomínající kůru pomeranče. Každé zrno se totiž natáčí a deformuje samostatně. Prevencí je jemnozrnný materiál — čím jemnější zrno, tím hladší povrch.</p>
    <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:20px;color:#eaf2fa;margin:14px 0 10px">Zbytková pnutí</div>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 20px">Nerovnoměrná deformace zanechá v dílu vnitřní napětí i po vyjmutí z nástroje. Díl se může časem zkroutit, po obrábění „ujet“ z rozměru nebo — v korozním prostředí — prasknout korozí pod napětím. Odstraňuje se žíháním ke snížení pnutí.</p>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:26px 0 8px">
      <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;padding:20px">
        <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:12.5px;letter-spacing:0.07em;text-transform:uppercase;color:#7ba3cc;margin-bottom:8px">Příčina</div>
        <div style="font-size:14.5px;line-height:1.6;color:#c4d2de">Výrazná mez kluzu a stárnutí oceli, hrubé zrno výchozího plechu, nerovnoměrné rozložení deformace v dílu.</div>
      </div>
      <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;padding:20px">
        <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:12.5px;letter-spacing:0.07em;text-transform:uppercase;color:#7ba3cc;margin-bottom:8px">Projev</div>
        <div style="font-size:14.5px;line-height:1.6;color:#c4d2de">Reliéf pásů pod 45°, drsný povrch typu pomerančové kůry, deformace nebo prasknutí dílu až s odstupem času.</div>
      </div>
      <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;padding:20px">
        <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:12.5px;letter-spacing:0.07em;text-transform:uppercase;color:#7ba3cc;margin-bottom:8px">Prevence</div>
        <div style="font-size:14.5px;line-height:1.6;color:#c4d2de">Dresírování plechu před tvářením, jemnozrnný materiál, zpracovat plech před vyčerpáním doby skladování, žíhání ke snížení pnutí.</div>
      </div>
    </div>
  </div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  renderVals() { return {}; }
}

(function () {
  const P = '../../';
  const FALLBACK_NAV = [{ title: 'Domů', href: '../../index.html' }, { title: 'Vnitřní stavba kovů a TZ', href: '../../vnitrni-stavba-kovu-a-tz/index.html?view=home' }, { title: 'Koroze', href: '../../koroze/index.html' }, { title: 'Tváření', href: '../../tvareni-za-tepla/index.html' }, { title: 'O projektu', href: '../../o-projektu.html' }, { title: 'Novinky', href: '../../novinky.html' }];
  const rv = Component.prototype.renderVals;
  Component.prototype.renderVals = function () {
    const base = rv ? (rv.call(this) || {}) : {};
    const n = this.state && this.state.__nav;
    const navItems = n ? n.map(i => ({ title: i.title, href: P + i.href })) : FALLBACK_NAV;
    return Object.assign({}, base, { navItems });
  };
  const cdm = Component.prototype.componentDidMount;
  Component.prototype.componentDidMount = function () {
    if (cdm) cdm.call(this);
    fetch(P + 'site-structure.json').then(r => r.json()).then(s => this.setState({ __nav: s.nav })).catch(() => {});
  };
})();
</script>
</body>
</html>
