<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trhliny za tepla | STT</title>
<meta name="description" content="Tváření pod dolní mezí, tahová napětí na povrchu a nízká tvárnost oceli.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23fbf8f3'/%3E%3Ctext x='12' y='17' font-family='Georgia,serif' font-size='12' font-weight='700' fill='%23b0561f' text-anchor='middle'%3ES%3C/text%3E%3C/svg%3E">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <script defer src="https://cloud.umami.is/script.js" data-website-id="4c272434-8fc9-49a9-9a2c-b3e710506cae"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>html, body { margin: 0; background: #080b12; } a { color: inherit; text-decoration: none; }</style>
  <script>
    document.addEventListener('mouseover', function(e){ var el = e.target.closest('.site-nav-toggle'); if (el) el.style.maxHeight = el.scrollHeight + 'px'; });
    document.addEventListener('mouseout', function(e){ var el = e.target.closest('.site-nav-toggle'); if (el && !el.contains(e.relatedTarget)) el.style.maxHeight = '48px'; });
  </script>
</helmet>
<div class="site-nav-toggle" style="position:fixed;top:24px;right:24px;z-index:1000;width:220px;background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;box-shadow:0 2px 10px rgba(35,29,22,0.08);overflow:hidden;max-height:48px;transition:max-height 0.22s ease">
  <div style="height:48px;display:flex;align-items:center;justify-content:center;gap:5px;flex-direction:column;cursor:pointer">
    <span style="width:20px;height:2px;background:#8296a8;border-radius:1px"></span>
    <span style="width:20px;height:2px;background:#8296a8;border-radius:1px"></span>
    <span style="width:20px;height:2px;background:#8296a8;border-radius:1px"></span>
  </div>
  <div style="display:flex;flex-direction:column;border-top:1px solid rgba(150,180,210,0.16)">
    <sc-for list="{{ navItems }}" as="n" hint-placeholder-count="6">
      <a href="{{ n.href }}" style="padding:12px 18px;font-family:'Quicksand',sans-serif;font-weight:600;font-size:14px;color:#eaf2fa" style-hover="background:rgba(150,180,210,0.08)">{{ n.title }}</a>
    </sc-for>
  </div>
</div>
<a href="index.html" style="position:fixed;top:16px;left:16px;z-index:1000;display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,0.08);backdrop-filter:blur(6px);color:#e8ecf3;font-family:'IBM Plex Sans',sans-serif;font-size:14px;font-weight:500;border:1px solid rgba(255,255,255,0.14)">← Zpět na Vady při tváření</a>

<div style="min-height:100vh;background:#080b12;font-family:'IBM Plex Sans',sans-serif;padding:78px 48px 80px;box-sizing:border-box;color:#eaf2fa">
  <div style="max-width:820px;margin:0 auto">
    <div style="font-family:'Quicksand',sans-serif;font-weight:600;font-size:13.5px;letter-spacing:0.06em;text-transform:uppercase;color:#eda962;margin-bottom:8px">Vady za tepla</div>
    <h1 style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:34px;line-height:1.2;color:#eaf2fa;margin:0 0 20px">Trhliny za tepla</h1>

    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 20px">Trhliny při tváření za tepla mají tři různé příčiny, které lze vyčíst přímo z teplotního intervalu tváření.</p>
    <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;padding:22px;margin:0 0 22px"><svg viewBox="0 0 720 260" width="100%" style="display:block">
  <defs><linearGradient id="gi" x1="0" y1="1" x2="0" y2="0">
    <stop offset="0%" stop-color="#3a4658"/><stop offset="40%" stop-color="#b05a3a"/><stop offset="75%" stop-color="#eda962"/><stop offset="100%" stop-color="#fdf1c8"/></linearGradient></defs>
  <rect x="70" y="20" width="70" height="210" rx="8" fill="url(#gi)" opacity="0.9"/>
  <rect x="70" y="20" width="580" height="42" fill="rgba(224,101,90,0.18)"/>
  <rect x="70" y="188" width="580" height="42" fill="rgba(224,101,90,0.18)"/>
  <line x1="70" y1="62" x2="650" y2="62" stroke="#e0655a" stroke-width="1.6" stroke-dasharray="6 5"/>
  <line x1="70" y1="188" x2="650" y2="188" stroke="#e0655a" stroke-width="1.6" stroke-dasharray="6 5"/>
  <text x="164" y="40" font-family="Quicksand,sans-serif" font-weight="700" font-size="15" fill="#e0655a">Nad horní mezí — přehřátí a spálení</text>
  <text x="164" y="56" font-family="IBM Plex Sans,sans-serif" font-size="13" fill="#a5788f">hrubnutí zrna, oxidace, natavení hranic</text>
  <text x="164" y="128" font-family="Quicksand,sans-serif" font-weight="700" font-size="16" fill="#8fd3ad">Teplotní interval tváření</text>
  <text x="164" y="148" font-family="IBM Plex Sans,sans-serif" font-size="13.5" fill="#aebfcf">nízký přetvárný odpor, kov rekrystalizuje</text>
  <text x="164" y="210" font-family="Quicksand,sans-serif" font-weight="700" font-size="15" fill="#e0655a">Pod dolní mezí — trhliny</text>
  <text x="164" y="226" font-family="IBM Plex Sans,sans-serif" font-size="13" fill="#a5788f">kov se zpevňuje, tvárnost je vyčerpaná</text>
  <text x="60" y="26" text-anchor="end" font-family="IBM Plex Sans,sans-serif" font-size="13" fill="#8296a8">1250 °C</text>
  <text x="60" y="192" text-anchor="end" font-family="IBM Plex Sans,sans-serif" font-size="13" fill="#8296a8">800 °C</text>
</svg><div style="font-family:'IBM Plex Sans',sans-serif;font-size:13.5px;line-height:1.55;color:#8296a8;margin-top:14px">Vady vznikají nad horní i pod dolní mezí intervalu. Uvnitř intervalu je materiál nejlépe tvárný. Uvedené teploty platí pro nelegované uhlíkové oceli.</div></div>
    <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:20px;color:#eaf2fa;margin:14px 0 10px">1 · Dokovací teplota — tváření pod dolní mezí</div>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 20px">Když kovář dokovává vychladlý kus, kov už nerekrystalizuje, ale zpevňuje se. Přetvárný odpor prudce roste, tvárnost klesá a materiál praská. Poznávacím znakem jsou trhliny na hranách a v místech největší deformace.</p>
    <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:20px;color:#eaf2fa;margin:14px 0 10px">2 · Tahová napětí na volném povrchu</div>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 20px">Při pěchování a válcování je střed průřezu tlačen, ale volný povrch je namáhán tahem. Překročí-li tah pevnost, vzniká podélná trhlina — typicky soudkovitý bok při pěchování nebo boky vývalku.</p>
    <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:20px;color:#eaf2fa;margin:14px 0 10px">3 · Náchylnost materiálu</div>
    <p style="font-size:16.5px;line-height:1.7;color:#aebfcf;margin:0 0 20px">Ocel s vyšším obsahem síry tvoří na hranicích zrn nízkotavitelný sulfid železa, který se za tepla natavuje — ocel je za červeného žáru křehká. Řeší se vazbou síry na mangan (MnS má vyšší teplotu tavení).</p>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:26px 0 8px">
      <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;padding:20px">
        <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:12.5px;letter-spacing:0.07em;text-transform:uppercase;color:#eda962;margin-bottom:8px">Příčina</div>
        <div style="font-size:14.5px;line-height:1.6;color:#c4d2de">Dokování pod dolní mezí, tahová napětí na volném povrchu, vyšší obsah síry nebo příliš rychlá deformace.</div>
      </div>
      <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;padding:20px">
        <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:12.5px;letter-spacing:0.07em;text-transform:uppercase;color:#eda962;margin-bottom:8px">Projev</div>
        <div style="font-size:14.5px;line-height:1.6;color:#c4d2de">Podélné trhliny na hranách a bocích, praskliny v místech největšího přetvoření, u červenolomých ocelí rozpad na hranicích zrn.</div>
      </div>
      <div style="background:rgba(120,150,180,0.05);border:1px solid rgba(150,180,210,0.16);border-radius:16px;padding:20px">
        <div style="font-family:'Quicksand',sans-serif;font-weight:700;font-size:12.5px;letter-spacing:0.07em;text-transform:uppercase;color:#eda962;margin-bottom:8px">Prevence</div>
        <div style="font-size:14.5px;line-height:1.6;color:#c4d2de">Dodržet dolní mez teploty a včas přihřát, volit menší úběry, zaoblit hrany polotovaru, používat oceli s vhodným poměrem Mn : S.</div>
      </div>
    </div>
  </div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  renderVals() { return {}; }
}

(function () {
  const P = '../../';
  const FALLBACK_NAV = [{ title: 'Domů', href: '../../index.html' }, { title: 'Vnitřní stavba kovů a TZ', href: '../../vnitrni-stavba-kovu-a-tz/index.html?view=home' }, { title: 'Koroze', href: '../../koroze/index.html' }, { title: 'Tváření', href: '../../tvareni-za-tepla/index.html' }, { title: 'O projektu', href: '../../o-projektu.html' }, { title: 'Novinky', href: '../../novinky.html' }];
  const rv = Component.prototype.renderVals;
  Component.prototype.renderVals = function () {
    const base = rv ? (rv.call(this) || {}) : {};
    const n = this.state && this.state.__nav;
    const navItems = n ? n.map(i => ({ title: i.title, href: P + i.href })) : FALLBACK_NAV;
    return Object.assign({}, base, { navItems });
  };
  const cdm = Component.prototype.componentDidMount;
  Component.prototype.componentDidMount = function () {
    if (cdm) cdm.call(this);
    fetch(P + 'site-structure.json').then(r => r.json()).then(s => this.setState({ __nav: s.nav })).catch(() => {});
  };
})();
</script>
</body>
</html>
